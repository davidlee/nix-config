{
  "lastChangelogVersion": "1.4.0",
  "defaultProjectTrust": "always",
  "defaultProvider": "llm-gateway",
  "defaultModel": "deepseek-flash",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": true,
  "compaction": {
    "enabled": false
  },
  "defaultTools": [
    "+codemode"
  ],
  "doubleEscapeAction": "tree",
  "packages": [
    "npm:@juanibiapina/pi-extension-settings",
    "npm:pi-subagents",
    "npm:pi-web-access",
    "npm:pi-simplify",
    "npm:pi-add-dir",
    "npm:pi-prompt-template-model",
    "npm:@juanibiapina/pi-powerbar",
    "npm:@tmustier/pi-usage-extension",
    "npm:@tmustier/pi-raw-paste",
    "npm:pi-btw",
    "npm:pi-interactive-shell",
    "npm:@victor-software-house/pi-curated-themes",
    "npm:pi-terminal-theme",
    "https://github.com/cathrynlavery/diagram-design"
  ],
  "enabledModels": [
    "llm-gateway/deepseek-flash",
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-6-sol"
