{
  "env": {
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  "permissions": {
    "allow": [],
    "defaultMode": "default"
  },
  "model": "opus[1m]",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "paplay /mnt/500G/home/david/.local/share/Steam/friends/voice_hang_up.wav 2>/dev/null || true",
            "async": true
          },
          {
            "type": "command",
            "command": "bash /home/david/.claude/record-turn-end.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "zmx-state-claude blocked",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/david/.claude/record-turn-end.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "zmx-state-claude working",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "notify-send 'Claude Code' 'Claude Code needs your attention'"
          }
        ]
      }
    ],
    "PreToolUse": [],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "zmx-state-claude working",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "zmx-state-claude working",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "zmx-state-claude blocked",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "zmx-state-claude blocked",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enableArtifact": false,
  "statusLine": {
    "type": "command",
    "command": "bash /home/david/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": false,
    "zig-lsp@cc-zig-lsp": false,
    "pyright-lsp@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "caveman@caveman": false,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "davidlee/codex-plugin-cc"
      }
    }
  },
  "effortLevel": "high",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "askUserQuestionTimeout": "never",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "normal",
  "verbose": true,
  "autoCompactEnabled": true,
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": false,
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
