build:
  just run dry-build --show-trace -v

regenerate-hardware:
   nixos-generate-config --show-hardware-config > hosts/{{host}}/hardware-configuration.nix
   nix fmt

gc:
  sudo nix-collect-garbage --delete-older-than 14d
  home-manager expire-generations "-7 days"
  nix-store --gc

melpa-list:
  nix eval --impure --raw --expr 'let f = builtins.getFlake "{{justfile_directory()}}/emacs"; pkgs = import f.inputs.nixpkgs { system = builtins.currentSystem; overlays = [ f.inputs.emacs-overlay.overlays.default ]; }; in builtins.concatStringsSep "\n" (builtins.attrNames pkgs.emacsPackages)' > emacs-packages.txt
