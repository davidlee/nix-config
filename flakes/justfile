# rebuild system

# Bundle the live ~/.emacs.d (a separate git repo, github:davidlee/emacs-config)
# on NixOS builds so local elisp edits land in the emacs package set without a
# push. The committed flake pins the GitHub source for portability (darwin has
# no local checkout to override against); these NixOS-only targets override it.
# emacs_override := "--override-input emacs-config path:" + home_directory() + "/.emacs.d"
# flakes/agents is locked from GitHub (portable); switch from the checkout so an
# agents/ edit lands without push + `nix flake update agents`. Linux-only consumer
# (overlays/agents.nix), so bundled with system_override, not home_override.
system_override := "--override-input oubliette git+file:///home/david/dev/oubliette/ --override-input agents path:" + justfile_directory() + "/agents"

# flakes/emacs is locked from GitHub (portable); switch from the checkout so an
# emacs.nix edit lands without push + `nix flake update emacs`.
home_override := "--override-input emacs path:" + justfile_directory() + "/emacs"

flake := "."

default: update-local fmt doctor choose

trial-upgrade: update system-build home-build



noop:
  @echo ''

choose:
 #@$(gum choose "noop" "system-switch" "home-switch" "flake-update-all" "everything") | xargs just
 @sel=$(gum choose "noop" "system-switch" "home-switch" "flake-update-all" "everything") && [ -n "$sel" ] && just "$sel"

fmt: check-flake-root
  nix fmt

# behaviour tests for the plain scripts under modules/home/linux/{bin,nudge}/
test:
  modules/home/linux/bin/snooze-nag-test
  nu modules/home/linux/nudge/nudge-test.nu

nixos-start-docker-daemon:
  systemctl --user start docker

run *args:
  export SYSTEM_OVERRIDE="{{system_override}}"
  sudo ./run.sh {{args}}

check-flake-root:
  @if [ -d .git ] && [ ! -e .git/HEAD ]; then echo "invalid .git directory at flake root shadows parent git repo: remove ./.git or move it aside"; exit 1; fi

system-switch: check-flake-root #check-no-root-pub
  sudo ./run.sh switch {{system_override}}

system-build: check-flake-root
  sudo ./run.sh build {{system_override}}

home-switch: check-flake-root #check-no-root-pub
  home-manager switch --flake '.#david' {{home_override}}

home-build: check-flake-root #check-no-root-pub
  home-manager build --flake '.#david' {{home_override}}

doctor:
  sleipnir-doctor

# drvPath of every configuration, evaluation only — the refactor gate in
# MULTIHOST.md: snapshot before a change, diff after. Each family uses its
# switch target's overrides; new hosts are picked up automatically.
#
# Two inputs vary with the repo rather than the config, so they are pinned
# here, or every edit/commit would read as a change:
# - nixos: the `agents` registry points at this flake's source (nix.nix), so
#   any file under flakes/ changes the system drv.
# - darwin: configurationRevision embeds the git rev (`-dirty` included).
drvs: check-flake-root
  @just _drvs nixosConfigurations 'c: (c.extendModules { modules = [({lib, ...}: { nix.registry.agents.to = lib.mkForce { type = "path"; path = "/drvs-gate"; }; })]; }).config.system.build.toplevel' "{{system_override}}"
  @just _drvs homeConfigurations 'c: c.activationPackage' "{{home_override}}"
  @just _drvs darwinConfigurations 'c: (c.extendModules { modules = [({lib, ...}: { system.configurationRevision = lib.mkForce null; })]; }).system' "{{home_override}}"

_drvs output pick overrides:
  @nix eval --raw '.#{{output}}' {{overrides}} --no-write-lock-file --apply 'cs: let pick = {{pick}}; in builtins.concatStringsSep "" (map (n: "{{output}}.${n} ${(pick cs.${n}).drvPath}\n") (builtins.attrNames cs))'

# Explicit path references bypass the bare dotfiles repository in ~/.git.
# Build first as the login user; only activation needs root.
darwin-build host="Davids-MacBook-Pro":
  nix build 'path:{{justfile_directory()}}#darwinConfigurations.{{host}}.system' {{home_override}} --out-link result-darwin --no-write-lock-file

darwin-switch host="Davids-MacBook-Pro": (darwin-build host)
  sudo -H ./result-darwin/sw/bin/darwin-rebuild switch --flake 'path:{{justfile_directory()}}#{{host}}' {{home_override}} --no-write-lock-file

everything: fmt update-system update-home system-switch home-switch

update: update-system update-home

