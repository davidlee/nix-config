# rebuild system

# Bundle the live ~/.config/emacs (a separate git repo, github:davidlee/emacs-config)
# on NixOS builds so local elisp edits land in the emacs package set without a
# push. The committed flake pins the GitHub source for portability (darwin has
# no local checkout to override against); these NixOS-only targets override it.
# emacs_override := "--override-input emacs-config path:" + home_directory() + "/.config/emacs"

# Every input is declared by its remote URL and locked from it (DEC-038).
# Read-only recipes build from local sources instead, so an edit lands without
# push + `nix flake update`; lock-writing recipes (update-*) never override.
#
# In-tree inputs (agents/, emacs/), present wherever this justfile is.
tree_override := "--override-input agents path:" + justfile_directory() + "/agents" + " --override-input emacs path:" + justfile_directory() + "/emacs"

# Dev checkouts present on this machine (bin/dev-checkouts, DEC-037): empty
# where ~/dev has none (the Mac), so no recipe needs one.
dev_override := `bin/dev-checkouts override`
local_override := tree_override + " " + dev_override

# just isolation: every dev-checkout input overridden to an empty flake, so a
# reference to one's packages or homeManagerModules fails evaluation and names
# it (DEC-034).
stub_override := `bin/dev-checkouts stub`

# The Mac needs an explicit path: reference, because the dotfiles repository
# at ~/.git is bare and git discovery fails there ("this operation must be
# run in a work tree"). Linux keeps `.`.
flake := if os() == "macos" { "path:" + justfile_directory() } else { "." }

# configurations are keyed by short hostname (hosts/<host>/); override with host=…
host := `hostname -s`

default: update-local fmt doctor choose

trial-upgrade: update system-build home-build



noop:
  @echo ''

choose:
 #@$(gum choose "noop" "system-switch" "home-switch" "flake-update-all" "everything") | xargs just
 @sel=$(gum choose "noop" "system-switch" "home-switch" "flake-update-all" "everything") && [ -n "$sel" ] && just "$sel"

fmt: check-flake-root
  nix fmt

# the lock holds no local source (ISS-006), resolver tests (features-test.nix),
# factory checks (hosts.nix), then behaviour tests for the plain scripts
test:
  @jq -e '[.nodes[].locked // empty | select(.type == "path" or ((.url // "") | startswith("file:")))] == []' flake.lock >/dev/null || { echo "flake.lock locks a local source: re-lock it without --override-input (just update-local)"; exit 1; }
  nix build ".#checks.$(nix config show system).features" {{local_override}} --no-link --no-write-lock-file
  nix build ".#checks.$(nix config show system).factories" {{local_override}} --no-link --no-write-lock-file
  nix build ".#checks.$(nix config show system).host-meta" {{local_override}} --no-link --no-write-lock-file
  bin/dev-checkouts-test
  features/session/snooze-nag-test
  features/audio/dictate-test
  features/audio/say-test
  nu features/attention/nudge/nudge-test.nu

# what `doctrine check gate` runs: `nix fmt`'s treefmt programs as a
# read-only flake check (alejandra, statix, deadnix), then the tests.
# --no-write-lock-file: a check never re-locks (CHR-008).
gate: test
  nix build ".#checks.$(nix config show system).treefmt" {{local_override}} --no-link --no-write-lock-file

nixos-start-docker-daemon:
  systemctl --user start docker

run cmd *args:
  sudo ./run.sh {{cmd}} {{host}} {{local_override}} {{args}}

check-flake-root:
  @if [ -d .git ] && [ ! -e .git/HEAD ]; then echo "invalid .git directory at flake root shadows parent git repo: remove ./.git or move it aside"; exit 1; fi

system-switch: check-flake-root #check-no-root-pub
  sudo ./run.sh switch {{host}} {{local_override}}

system-build: check-flake-root
  sudo ./run.sh build {{host}} {{local_override}}

home-switch: check-flake-root #check-no-root-pub
  home-manager switch --flake '{{flake}}#david@{{host}}' {{local_override}}

home-build: check-flake-root #check-no-root-pub
  home-manager build --flake '{{flake}}#david@{{host}}' {{local_override}}

doctor:
  sleipnir-doctor

# nixos pick for drvs and coverage: drvPath, `agents` registry pinned (below).
nixos_pick := 'c: let pinned = c.extendModules { modules = [({lib, ...}: { nix.registry.agents.to = lib.mkForce { type = "path"; path = "/drvs-gate"; }; })]; }; in (if c.config.nix.registry ? agents then pinned else c).config.system.build.toplevel.drvPath'

# coverage pick: a home target's activation drvPath, else nixos_pick.
coverage_pick := 'c: if c ? activationPackage then c.activationPackage.drvPath else (' + nixos_pick + ') c'

# drvPath of every configuration, evaluation only — the refactor gate
# (mem.pattern.flakes.drv-gate): snapshot before a change, diff after.
# Every family evaluates with local_override, as the switch recipes do; new
# hosts are picked up automatically.
#
# Two inputs vary with the repo rather than the config, so they are pinned
# here, or every edit/commit would read as a change:
# - nixos: the `agents` registry (agents.registry) points at this flake's
#   source, so any file under flakes/ changes the system drv. Pinned only
#   where the entry exists, so the gate never invents it.
# - darwin: configurationRevision embeds the git rev (`-dirty` included).
drvs: check-flake-root
  @just _drvs nixosConfigurations '{{nixos_pick}}' "{{local_override}}"
  @just _drvs homeConfigurations 'c: c.activationPackage.drvPath' "{{local_override}}"
  @just _drvs darwinConfigurations 'c: (c.extendModules { modules = [({lib, ...}: { system.configurationRevision = lib.mkForce null; })]; }).system.drvPath' "{{local_override}}"
  @just _drvs packages 'ps: set (builtins.attrValues ps)' "{{local_override}}"
  @just _drvs legacyPackages 'lp: if lp ? stdenv then builtins.concatStringsSep " " (map (n: lp.${n}.drvPath) ["stdenv" "codex" "claude"]) else "none"' "{{local_override}}"
  @just _drvs templates 't: "${t.path} ${t.description}"' ""

# ADR-005 coverage targets: evaluate off features, and the NixOS and home
# bases off x86, outside the switch path; pinned like drvs. Then isolation.
coverage: check-flake-root
  @just _drvs coverage '{{coverage_pick}}' "{{local_override}}"
  @just isolation

# Lean homes never reach a dev-checkout input (DEC-034): the home base, and
# Draupnir until a darwin feature needs one (IMP-023 removes that leg).
# Reports on stderr, so `just coverage`'s stdout stays one line per target.
isolation: check-flake-root
  #!/usr/bin/env bash
  set -uo pipefail
  fail=0
  for attr in 'coverage."home@aarch64-linux"' 'homeConfigurations."david@Draupnir"'; do
    if err=$(nix eval --raw '{{flake}}#'"$attr"'.activationPackage.drvPath' {{tree_override}} {{stub_override}} --no-write-lock-file 2>&1 >/dev/null); then
      echo "isolation: $attr ok" >&2
    else
      printf '%s\n' "$err" >&2; echo "isolation: $attr FAILED" >&2; fail=1
    fi
  done
  exit $fail

# Order-insensitive companion to drvs: count + hash of the *sorted* package
# lists. When drvs differs but these match, the package change is
# ordering-only. Other merged lists (groups, sudo rules, …) still need nix-diff.
drvs-sets: check-flake-root
  @just _drvs nixosConfigurations 'c: set c.config.environment.systemPackages' "{{local_override}}"
  @just _drvs homeConfigurations 'c: set c.config.home.packages' "{{local_override}}"
  @just _drvs darwinConfigurations 'c: set c.config.environment.systemPackages' "{{local_override}}"

# Built-artefact measures drvs cannot show (mem.pattern.flakes.drv-gate):
# the host's system and home under <outdir>/{system,home}, or one attr. A
# darwin host has no system mode (gate-probe measures NixOS): home only.
probe outdir attr="": check-flake-root
  #!/usr/bin/env bash
  set -euo pipefail
  if [ -n '{{attr}}' ]; then exec bin/gate-probe '{{outdir}}' '{{attr}}'; fi
  if [ '{{os()}}' != macos ]; then bin/gate-probe '{{outdir}}/system' 'nixosConfigurations.{{host}}'; fi
  bin/gate-probe '{{outdir}}/home' 'homeConfigurations."david@{{host}}"'

# pick: config -> string. `set` hashes a package list independent of order.
_drvs output pick overrides:
  @nix eval --raw '{{flake}}#{{output}}' {{overrides}} --no-write-lock-file --apply 'cs: let set = ps: "${toString (builtins.length ps)} ${builtins.hashString "sha256" (builtins.concatStringsSep " " (builtins.sort builtins.lessThan (map (p: p.drvPath) ps)))}"; pick = {{pick}}; in builtins.concatStringsSep "" (map (n: "{{output}}.${n} ${pick cs.${n}}\n") (builtins.attrNames cs))'

# Build first as the login user; only activation needs root.
darwin-build host=host:
  nix build '{{flake}}#darwinConfigurations.{{host}}.system' {{local_override}} --out-link result-darwin --no-write-lock-file

darwin-switch host=host: (darwin-build host)
  sudo -H ./result-darwin/sw/bin/darwin-rebuild switch --flake '{{flake}}#{{host}}' {{local_override}} --no-write-lock-file

everything: fmt update-system update-home system-switch home-switch

update: update-system update-home

