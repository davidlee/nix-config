#!/usr/bin/env python3
"""Behaviour tests for sleipnir-doctor and its panopticon provider. No
journal, no coredumpctl: each check's verdict is a pure function of the
records it reads, so each case passes records in.

  ./doctor-test
"""

import importlib.machinery
import importlib.util
import io
import sys
import tempfile
import unittest
from contextlib import redirect_stderr
from pathlib import Path

sys.dont_write_bytecode = True  # SourceFileLoader would leave __pycache__ in the repo

here = Path(__file__).resolve().parent


def load(name):
  loader = importlib.machinery.SourceFileLoader(name.replace("-", "_"), str(here / name))
  spec = importlib.util.spec_from_loader(loader.name, loader)
  module = importlib.util.module_from_spec(spec)
  sys.modules[loader.name] = module  # dataclasses look their module up
  loader.exec_module(module)
  return module


doctor = load("sleipnir-doctor")
panopticon = load("sleipnir-doctor-panopticon")

DISCONNECT = "WARNING panopticon.compositor: umbriel disconnected: EOF"
STOPPING = "Stopping panopticon — desktop behaviour event watcher..."
STARTED = "Started panopticon — desktop behaviour event watcher..."


def dump(sig, exe):
  return {"sig": sig, "exe": f"/nix/store/0000-pkg/bin/{exe}"}


class WatcherJournal(unittest.TestCase):
  def verdict(self, *lines):
    return panopticon.journal_verdict(list(lines))

  def test_quiet_journal_is_clean(self):
    self.assertEqual(self.verdict(STARTED), ("OK", "1 lines, clean"))

  def test_disconnect_as_the_session_ends_is_not_a_fault(self):
    self.assertEqual(self.verdict(STARTED, DISCONNECT, STOPPING, STARTED)[0], "OK")

  def test_disconnect_while_the_watcher_runs_on_is_a_fault(self):
    self.assertEqual(self.verdict(STARTED, DISCONNECT, STARTED),
                     ("WARN", "1 disconnects"))

  def test_a_disconnect_last_in_the_journal_is_a_fault(self):
    self.assertEqual(self.verdict(STARTED, DISCONNECT)[0], "WARN")

  def test_errors_warn(self):
    self.assertEqual(self.verdict("ERROR boom"), ("WARN", "1 errors"))

  def test_a_few_reconnects_are_tolerated(self):
    self.assertEqual(self.verdict(*["reconnected to umbriel"] * 3),
                     ("OK", "3 reconnects"))
    self.assertEqual(self.verdict(*["reconnected to umbriel"] * 4)[0], "WARN")


class Crashes(unittest.TestCase):
  def test_none_is_ok(self):
    self.assertEqual(doctor.crash_result([]), doctor.Result(doctor.OK, "0"))

  def test_a_crash_warns_and_names_the_program(self):
    r = doctor.crash_result([dump(6, ".umbriel-wrapped")])
    self.assertEqual(r, doctor.Result(doctor.WARN, "1 (.umbriel-wrapped)"))

  def test_repeat_crashes_are_counted_per_program(self):
    r = doctor.crash_result([dump(11, "a"), dump(11, "a"), dump(6, "b")])
    self.assertEqual(r.detail, "3 (a ×2, b)")

  def test_resource_limit_kills_are_not_crashes(self):
    # SIGXFSZ (25): a jail's file-size limit doing its job.
    r = doctor.crash_result([dump(25, "git")])
    self.assertEqual(r, doctor.Result(doctor.OK, "0 (1 limit kills)"))


class Freshness(unittest.TestCase):
  firefox = {"warn_minutes": 240, "crit_minutes": 24 * 60, "app": "firefox"}

  def result(self, age, running, cfg=None):
    return panopticon.freshness_result(cfg or self.firefox, age, True, running)

  def test_a_closed_app_is_not_a_stale_feed(self):
    self.assertEqual(self.result(600, running=False), ("OK", "10.0 h ago (firefox not running)"))
    self.assertEqual(self.result(None, running=False)[0], "OK")

  def test_a_running_app_with_a_stale_feed_warns(self):
    self.assertEqual(self.result(600, running=True), ("WARN", "10.0 h ago"))

  def test_a_fresh_feed_is_ok(self):
    self.assertEqual(self.result(5, running=True), ("OK", "5 min ago"))

  def test_a_source_without_an_app_is_judged_on_age_alone(self):
    self.assertEqual(self.result(None, running=True, cfg={"warn_minutes": 30}),
                     ("WARN", "no file"))

  def test_a_feed_dead_for_a_day_is_crit(self):
    self.assertEqual(self.result(25 * 60, running=True)[0], "CRIT")
    self.assertEqual(self.result(None, running=True)[0], "CRIT")

  def test_an_idle_machine_does_not_escalate(self):
    self.assertEqual(
      panopticon.freshness_result(self.firefox, 25 * 60, False, True)[0], "WARN")


class Zombies(unittest.TestCase):
  def test_a_few_are_tolerated(self):
    self.assertEqual(doctor.zombie_result(6).status, doctor.OK)

  def test_many_warn_then_crit(self):
    self.assertEqual(doctor.zombie_result(10).status, doctor.WARN)
    self.assertEqual(doctor.zombie_result(50).status, doctor.CRIT)


class Levels(unittest.TestCase):
  checks = [
    ("System", "disk", doctor.Result(doctor.OK, "fine")),
    ("System", "swap", doctor.Result(doctor.WARN, "low")),
    ("Nix", "store", doctor.Result(doctor.CRIT, "broken")),
  ]

  def names(self, level):
    return [n for _, n, _ in doctor.shown(self.checks, doctor.LEVELS[level])]

  def test_all_by_default(self):
    self.assertEqual(self.names(doctor.parse_args([]).level), ["disk", "swap", "store"])

  def test_warn_drops_ok(self):
    self.assertEqual(self.names("warn"), ["swap", "store"])

  def test_crit_shows_only_crit(self):
    self.assertEqual(self.names("crit"), ["store"])

  def test_an_unknown_level_is_a_usage_error(self):
    with self.assertRaises(SystemExit) as e, redirect_stderr(io.StringIO()):
      doctor.parse_args(["warnings"])
    self.assertEqual(e.exception.code, 2)


class Daily(unittest.TestCase):
  def test_runs_once_per_day(self):
    with tempfile.TemporaryDirectory() as d:
      stamp = Path(d) / "sub" / "last-run"
      self.assertTrue(doctor.claim_day(stamp, "2026-10-25"))
      self.assertFalse(doctor.claim_day(stamp, "2026-10-25"))
      self.assertTrue(doctor.claim_day(stamp, "2026-10-26"))


class Manifest(unittest.TestCase):
  def test_an_executable_profile_path_is_ok(self):
    path = "/home/u/.nix-profile/bin/panopticon-firefox-host"
    self.assertEqual(panopticon.manifest_result(path, executable=True), ("OK", path))

  def test_a_missing_manifest_is_crit(self):
    self.assertEqual(panopticon.manifest_result(None, executable=False)[0], "CRIT")

  def test_a_dangling_host_path_is_crit(self):
    status, detail = panopticon.manifest_result("/gone/host", executable=False)
    self.assertEqual(status, "CRIT")
    self.assertIn("/gone/host", detail)

  def test_a_store_path_warns_before_gc_breaks_it(self):
    path = "/nix/store/0000-panopticon/bin/panopticon-firefox-host"
    self.assertEqual(panopticon.manifest_result(path, executable=True)[0], "WARN")


if __name__ == "__main__":
  unittest.main()
