# Copy to .envrc. `use flake_pub` reads ~/flakes/pub live, not from
# flake.lock, so agent bumps land on the next reload (helper: direnv stdlib
# in ~/flakes/modules/home/shared/programs.nix). Elsewhere: plain flake.
if declare -F use_flake_pub >/dev/null; then
  use flake_pub --impure
else
  use flake . --impure
fi
