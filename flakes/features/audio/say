#!/usr/bin/env bash
# Speak text aloud: the arguments, or stdin when there are none.
#
#   say [-e piper|kokoro] [-d DEVICE] [TEXT...]
#
# pw-play plays the speech on DEVICE: a PipeWire sink's node.name (see
# `pw-cli ls Node`), or auto for the default sink. piper streams it sentence by
# sentence; kokoro can only write a whole wav first. Engine chatter is shown
# only if the engine fails.
#
# Defaults: SAY_ENGINE (piper), SAY_DEVICE (auto); per engine, PIPER_VOICE,
# KOKORO_VOICE and KOKORO_SPEED. piper is the quicker of the two. Voices are
# names; the speech feature ships both engines' voices, piper's in
# PIPER_VOICES.

set -euo pipefail

usage() {
  echo "usage: say [-e piper|kokoro] [-d DEVICE] [TEXT...]" >&2
  exit 2
}

# Engines read text on stdin, speak it on $device, and keep their chatter in
# $tmp/log.
piper_speak() {
  local voice="${PIPER_VOICE:-en_GB-cori-high}" rate
  rate=$(piper_rate "$voice") || return
  piper --model "$voice" --output-raw 2>"$tmp/log" |
    pw-play --target "$device" --raw --format s16 --channels 1 --rate "$rate" -
}

kokoro_speak() {
  kokoro --voice "${KOKORO_VOICE:-bf_emma}" --speed "${KOKORO_SPEED:-1.0}" \
    --output-file "$tmp/speech.wav" >"$tmp/log" 2>&1 &&
    pw-play --target "$device" "$tmp/speech.wav"
}

# Raw audio carries no header, so pw-play needs the rate from the voice config.
piper_rate() {
  local voices="${PIPER_VOICES:-}"
  jq -er .audio.sample_rate "$voices/$1.onnx.json" 2>/dev/null || {
    echo "say: no piper voice $1 in $voices" >&2
    return 1
  }
}

engine="${SAY_ENGINE:-piper}"
device="${SAY_DEVICE:-auto}"

while getopts e:d: opt; do
  case "$opt" in
    e) engine="$OPTARG" ;;
    d) device="$OPTARG" ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))

case "$engine" in
  piper | kokoro) ;;
  *) usage ;;
esac

if [ $# -gt 0 ]; then
  text="$*"
else
  text="$(cat)"
fi

[[ "$text" =~ [^[:space:]] ]] || exit 0

tmp=$(mktemp -d -p "${XDG_RUNTIME_DIR:-/tmp}" say-XXXXXX)
trap 'rm -rf "$tmp"' EXIT

printf '%s\n' "$text" | "${engine}_speak" || {
  [ ! -e "$tmp/log" ] || cat "$tmp/log" >&2
  exit 1
}
