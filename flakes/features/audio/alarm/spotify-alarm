#!/usr/bin/env bash
# Spotify alarm — switch to speakers and start playback. Fired by
# spotify-alarm.timer (weekdays) and spotify-alarm-weekend.timer.
# Safe to dry-run at any time: `spotify-alarm`.
#
# Three phases, each handling a class of silent failure. Full reliability
# notes in ALARM.md.

set -euo pipefail

export PATH="$HOME/.local/bin:/etc/profiles/per-user/$USER/bin:/run/current-system/sw/bin:$HOME/.nix-profile/bin:$PATH"

PLAYLIST_ID="2gs3W3XLA36fK0z3mL7MtJ"
# The Connect name is defined once, in spotifyd.conf (alarm.nix). It is
# unique on purpose: the Spotify desktop app registers as the hostname.
DEVICE_NAME=$(sed -n 's/^device_name = "\(.*\)"/\1/p' "$HOME/.config/spotifyd/spotifyd.conf")
: "${DEVICE_NAME:?no device_name in spotifyd.conf}"

# Route audio to the speakers if they are present; a missing speaker must
# not stop the alarm sounding somewhere.
if SPEAKERS=$(speakers-sink); then
  pactl set-default-sink "$SPEAKERS" || echo "could not set default sink $SPEAKERS"
else
  SPEAKERS=
  echo "speakers not found; using the current default sink"
fi

# --- Phase 1: get spotifyd connected to Spotify ---
# After S3 resume, the network takes 10-30s to stabilize. We restart
# spotifyd and poll its log for "active device is" (proof of connection).
# nm-online is best-effort (can return stale state after resume).
nm-online -q --timeout=30 || true
for round in 1 2 3; do
  systemctl --user restart spotifyd.service
  connected=false
  for _ in $(seq 1 30); do
    if journalctl --user -u spotifyd.service \
         --since "30 seconds ago" -o cat -q \
         | grep -q "active device is"; then
      connected=true; break
    fi
    sleep 1
  done
  if [ "$connected" = "true" ]; then break; fi
  echo "Round $round/3: spotifyd didn't connect, retrying..."
done

# --- Phase 2: activate the device ---
# Refresh spotify-player first: the long-lived daemon's cached Web API
# view can miss devices that (re)registered while it was idle across S3
# cycles. Then wait until it answers; just after a restart the CLI can
# fail to reach it (the daemon's UDP port is not yet usable).
systemctl --user restart spotify-player.service
for _ in $(seq 1 30); do
  spotify_player get key devices >/dev/null 2>&1 && break
  sleep 1
done

# connect returns exit 0 regardless of success, so verify activation via
# the API. The API lags spotifyd's log by a few seconds, so retry.
# Python takes the name via argv, never interpolated into code.
device_field() { # FIELD -> that field of the device named $DEVICE_NAME
  python3 -c "import sys,json
for d in json.load(sys.stdin):
  if d['name'] == sys.argv[1]: print(d[sys.argv[2]])" "$DEVICE_NAME" "$1"
}
activated=false
for attempt in $(seq 1 12); do
  if ! RAW=$(spotify_player get key devices 2>&1); then
    echo "Attempt $attempt/12: get key devices failed: $RAW"
  elif ! id=$(printf '%s' "$RAW" | device_field id) || [ -z "$id" ]; then
    echo "Attempt $attempt/12: no $DEVICE_NAME device in API yet (raw: $RAW)"
  else
    spotify_player connect --id "$id" 2>/dev/null || true
    sleep 1
    if spotify_player get key devices 2>/dev/null | device_field is_active | grep -qx True; then
      echo "Activated device $id"
      activated=true; break
    fi
    echo "Attempt $attempt/12: activation failed"
  fi
  sleep 5
done
if [ "$activated" != "true" ]; then
  echo "Failed to activate $DEVICE_NAME"
  exit 1
fi

# --- Phase 3: start playback ---
spotify_player playback start context \
  --id "$PLAYLIST_ID" playlist --shuffle 2>/dev/null || true
spotify_player playback play 2>/dev/null || true
spotify_player playback volume 100 2>/dev/null || true

# Move all sink inputs (including spotifyd's new one) to speakers.
# set-default-sink above covers new streams, but this catches any
# that were already routed elsewhere.
if [ -n "$SPEAKERS" ]; then
  pactl set-sink-volume "$SPEAKERS" 90% || true
  sleep 1
  pactl list short sink-inputs \
    | awk '{print $1}' \
    | while read -r id; do
        pactl move-sink-input "$id" "$SPEAKERS" || true
      done
fi
echo "Alarm started"
