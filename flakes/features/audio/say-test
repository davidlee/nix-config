#!/usr/bin/env bash
# Behaviour tests for say. No speech engine and no speakers: piper, kokoro and
# pw-play are stubbed onto PATH, and piper's voices are two fixture configs,
# so each case asserts what was rendered, by which engine, and how and where
# it was played.
#
#   ./say-test

set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
script=$here/say

stubs=$(mktemp -d)
trap 'rm -rf "$stubs"' EXIT

# ------------------------------------------------------------------ stubs

# Each engine logs its arguments and the text it was fed, chatters as the
# real ones do, then writes fake audio naming itself: piper streams it to
# stdout, kokoro writes its --output-file. SAY_TEST_FAIL makes it fail instead.
for engine in piper kokoro; do
  cat >"$stubs/$engine" <<EOF
#!/usr/bin/env bash
out=\$(printf '%s\n' "\$@" | sed -n '/^--output-file$/{n;p}')
printf '%s\n' "\$*" >"\$SAY_TEST_DIR/$engine.args"
cat >"\$SAY_TEST_DIR/$engine.text"
echo "$engine chatter" >&2
[ -z "\${SAY_TEST_FAIL:-}" ] || { echo "$engine broke" >&2; exit 1; }
if [ -n "\$out" ]; then
  echo "$engine prompt"
  echo "$engine audio" >"\$out"
else
  echo "$engine audio"
fi
EOF
done

# Logs its arguments, its target, and the audio it was handed: the last
# argument, read from stdin when that is `-`.
cat >"$stubs/pw-play" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >"$SAY_TEST_DIR/pw-play.args"
printf '%s\n' "$@" | sed -n '/^--target$/{n;p}' >"$SAY_TEST_DIR/target"
source=${*: -1}
[ "$source" = - ] && source=/dev/stdin
cat "$source" >"$SAY_TEST_DIR/played"
[ -z "${SAY_TEST_HANG:-}" ] || exec sleep 5
EOF

mkdir "$stubs/voices"
echo '{"audio": {"sample_rate": 22050}}' >"$stubs/voices/en_GB-cori-high.onnx.json"
echo '{"audio": {"sample_rate": 16000}}' >"$stubs/voices/en_GB-alba-medium.onnx.json"

chmod +x "$stubs"/*

# ------------------------------------------------------------------ harness

failures=0
dir=
status=
err=

# Runs say in a fresh directory with the stubs first on PATH; extra
# environment comes in as NAME=value words before `--`.
run() {
  dir=$(mktemp -d -p "$stubs")
  mkdir "$dir/runtime"
  local env=()
  while [ "$1" != -- ]; do env+=("$1"); shift; done
  shift
  status=0
  err=$(env -u SAY_ENGINE -u SAY_DEVICE -u PIPER_VOICE -u KOKORO_VOICE -u KOKORO_SPEED \
    PATH="$stubs:$PATH" SAY_TEST_DIR="$dir" XDG_RUNTIME_DIR="$dir/runtime" \
    PIPER_VOICES="$stubs/voices" "${env[@]}" "$script" "$@" 2>&1 <"${SAY_TEST_STDIN:-/dev/null}") || status=$?
}

check() {
  local name=$1 expected=$2 actual=$3
  if [ "$expected" = "$actual" ]; then
    echo "ok    $name"
  else
    echo "FAIL  $name: expected [$expected], got [$actual]"
    failures=$((failures + 1))
  fi
}

file() { cat "$dir/$1" 2>/dev/null || echo "<none>"; }
leftovers() { find "$dir/runtime" -mindepth 1 | wc -l; }
raw_rate() { file pw-play.args | grep -Po -- '--raw --format s16 --channels 1 --rate \K[0-9]+(?= -$)'; }

# ------------------------------------------------------------------ cases

run -- hello there
check "args: piper speaks them" "hello there" "$(file piper.text)"
check "args: in the default voice" "en_GB-cori-high" "$(file piper.args | grep -Po -- '--model \K[^ ]+')"
check "args: played on the default sink" "auto" "$(file target)"
check "args: piper's audio is played" "piper audio" "$(file played)"
check "args: streamed raw at the voice's rate" 22050 "$(raw_rate)"
check "args: engine chatter is hidden" "" "$err"
check "args: nothing left behind" 0 "$(leftovers)"

printf 'from a pipe\n' >"$stubs/stdin"
SAY_TEST_STDIN=$stubs/stdin run --
check "stdin: spoken when no args" "from a pipe" "$(file piper.text)"

run -- -d some.sink hi
check "-d: names the sink" "some.sink" "$(file target)"

run SAY_DEVICE=env.sink -- hi
check "SAY_DEVICE: default sink" "env.sink" "$(file target)"

run SAY_DEVICE=env.sink -- -d flag.sink hi
check "-d: overrides SAY_DEVICE" "flag.sink" "$(file target)"

run PIPER_VOICE=en_GB-alba-medium -- hi
check "PIPER_VOICE: names the voice" "en_GB-alba-medium" "$(file piper.args | grep -Po -- '--model \K[^ ]+')"
check "PIPER_VOICE: streamed at that voice's rate" 16000 "$(raw_rate)"

run PIPER_VOICE=en_GB-nobody-low -- hi
check "unknown piper voice: say fails" 1 "$status"
check "unknown piper voice: says where it looked" \
  "say: no piper voice en_GB-nobody-low in $stubs/voices" "$err"
check "unknown piper voice: nothing rendered" "<none>" "$(file piper.text)"

run KOKORO_VOICE=bm_george KOKORO_SPEED=1.2 -- -e kokoro hi
check "-e kokoro: kokoro speaks" "hi" "$(file kokoro.text)"
check "-e kokoro: voice and speed passed" \
  "--voice bm_george --speed 1.2" "$(file kokoro.args | grep -o -- '--voice .* --speed [^ ]*')"
check "-e kokoro: piper unused" "<none>" "$(file piper.text)"
check "-e kokoro: its wav is played" "kokoro audio" "$(file played)"
check "-e kokoro: engine chatter is hidden" "" "$err"
check "-e kokoro: nothing left behind" 0 "$(leftovers)"

run SAY_ENGINE=kokoro -- hi
check "SAY_ENGINE: default engine" "kokoro audio" "$(file played)"

printf ' \n\t\n' >"$stubs/stdin"
SAY_TEST_STDIN=$stubs/stdin run --
check "blank: succeeds" 0 "$status"
check "blank: nothing rendered" "<none>" "$(file piper.text)"

run -- -e espeak hi
check "unknown engine: usage error" 2 "$status"
check "unknown engine: says how to use it" "usage: say [-e piper|kokoro] [-d DEVICE] [TEXT...]" "$err"

run SAY_TEST_FAIL=1 -- hi
check "piper fails: say fails" 1 "$status"
check "piper fails: its output shown" "piper chatter
piper broke" "$err"
check "piper fails: nothing left behind" 0 "$(leftovers)"

run SAY_TEST_FAIL=1 -- -e kokoro hi
check "kokoro fails: say fails" 1 "$status"
check "kokoro fails: its output shown" "kokoro chatter
kokoro broke" "$err"
check "kokoro fails: nothing played" "<none>" "$(file played)"
check "kokoro fails: nothing left behind" 0 "$(leftovers)"

# Interrupted mid-playback: nothing is left behind.
dir=$(mktemp -d -p "$stubs")
mkdir "$dir/runtime"
PATH="$stubs:$PATH" SAY_TEST_DIR="$dir" XDG_RUNTIME_DIR="$dir/runtime" \
  PIPER_VOICES="$stubs/voices" SAY_TEST_HANG=1 "$script" -e kokoro hi </dev/null >/dev/null 2>&1 &
pid=$!
for _ in $(seq 50); do [ -e "$dir/played" ] && break; sleep 0.1; done
kill -TERM "$pid" 2>/dev/null || true
wait "$pid" 2>/dev/null || true
check "interrupted: nothing left behind" 0 "$(leftovers)"

# ------------------------------------------------------------------ result

if [ "$failures" -gt 0 ]; then
  echo "$failures failed"
  exit 1
fi
echo "all passed"
