class CredentialTest(unittest.TestCase):
    """EX-4, the RV-024 F-5 control: the launcher refuses to start without a
    configured provider's credential, naming it and the fix. The providers
    are the launcher's baked PROVIDERS, those the production config uses."""

    def test_the_baked_PROVIDERS_are_the_production_configs(self):
        self.assertEqual(
            {f"os.environ/{env}" for env in serve.PROVIDERS.values()},
            {m["litellm_params"]["api_key"] for m in model_list(PRODUCTION_CONFIG)},
        )

    def refusal(self, environ):
        with self.assertRaises(SystemExit) as refused:
            serve.load_credentials(serve.PROVIDERS, environ)
        message = str(refused.exception.code)
        for name in serve.PROVIDERS:
            self.assertIn(name, message)
        self.assertIn("just gateway-credentials", message)

    def test_unset_CREDENTIALS_DIRECTORY_names_every_credential_and_the_fix(self):
        self.refusal({})

    def test_a_missing_credential_file_names_it_and_the_fix(self):
        with tempfile.TemporaryDirectory() as empty:
            self.refusal({"CREDENTIALS_DIRECTORY": empty})

    def test_an_empty_credential_is_refused_like_a_missing_one(self):
        """RV-026 F-2."""
        with tempfile.TemporaryDirectory() as directory:
            write_credentials(directory, " \n")
            self.refusal({"CREDENTIALS_DIRECTORY": directory})

    def test_a_present_credential_is_loaded_into_its_variable(self):
        with tempfile.TemporaryDirectory() as directory:
            write_credentials(directory, PROVIDER_SECRET + "\n")
            loaded = serve.load_credentials(
                serve.PROVIDERS, {"CREDENTIALS_DIRECTORY": directory}
            )
        for name, env in serve.PROVIDERS.items():
            with self.subTest(provider=name):
                self.assertEqual(loaded[env], PROVIDER_SECRET)
        self.assertEqual(len(loaded), len(serve.PROVIDERS))

    def test_the_credential_check_runs_before_litellm_is_imported(self):
        with (
            tempfile.TemporaryDirectory() as shadow,
            tempfile.TemporaryDirectory() as empty,
        ):
            (Path(shadow) / "litellm").mkdir()
            (Path(shadow) / "litellm" / "__init__.py").write_text(
                'raise ImportError("imported before credential check")\n'
            )
            environ = {
                **os.environ,
                "PYTHONPATH": os.pathsep.join(
                    [shadow, os.environ.get("PYTHONPATH", "")]
                ),
                "CREDENTIALS_DIRECTORY": empty,
            }
            done = subprocess.run(
                [sys.executable, str(SERVE)],
                env=environ,
                capture_output=True,
                text=True,
                check=False,
                timeout=60,
            )
        self.assertNotEqual(done.returncode, 0)
        self.assertIn("just gateway-credentials", done.stderr)
        self.assertNotIn("imported before credential check", done.stderr)

    def test_unset_CONFIG_FILE_PATH_is_named(self):
        environ = {k: v for k, v in os.environ.items() if k != "CONFIG_FILE_PATH"}
        done = subprocess.run(
            [sys.executable, str(SERVE)],
            env=environ,
            capture_output=True,
            text=True,
            check=False,
            timeout=60,
        )
        self.assertNotEqual(done.returncode, 0)
        self.assertIn("CONFIG_FILE_PATH", done.stderr)


