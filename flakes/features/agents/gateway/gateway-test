# --- route_gate in isolation: a recording app stands in for LiteLLM ---------


class Recorder:
    """An inner ASGI app that records every scope it is handed."""

    def __init__(self):
        self.scopes = []

    async def __call__(self, scope, receive, send):
        self.scopes.append(scope)
        if scope["type"] == "http":
            await send({"type": "http.response.start", "status": 200, "headers": []})
            await send({"type": "http.response.body", "body": b"inner"})


class Reader(Recorder):
    """A Recorder that first reads the request body, as LiteLLM does, into
    `bodies`."""

    def __init__(self):
        super().__init__()
        self.bodies = []

    async def __call__(self, scope, receive, send):
        body, more = b"", True
        while more:
            message = await receive()
            body += message.get("body", b"")
            more = message.get("more_body", False)
        self.bodies.append(body)
        await super().__call__(scope, receive, send)


def call_with_body(asgi, scope, chunks):
    """Run one ASGI call, the request body arriving as `chunks`, one
    http.request message each, then http.disconnect; return the messages
    sent and the number of receive calls."""
    sent, reads = [], 0
    received = [
        {"type": "http.request", "body": chunk, "more_body": i < len(chunks) - 1}
        for i, chunk in enumerate(chunks)
    ]

    async def receive():
        nonlocal reads
        reads += 1
        return received.pop(0) if received else {"type": "http.disconnect"}

    async def send(message):
        sent.append(message)

    asyncio.run(asgi(scope, receive, send))
    return sent, reads


def call(asgi, scope):
    """Run one ASGI call with an empty JSON object for a body; return the
    messages it sent."""
    return call_with_body(asgi, scope, [b"{}"])[0]


def http(method, path, raw_path=None, headers=()):
    scope = {"type": "http", "method": method, "path": path, "headers": list(headers)}
    if raw_path is not None:
        scope["raw_path"] = raw_path
    return scope


def post(headers=(), path="/v1/chat/completions"):
    return http("POST", path, path.encode(), headers)


def sized(n):
    """A JSON object of exactly `n` bytes, every field on the list."""
    shell = b'{"model": ""}'
    return shell[:-2] + b"x" * (n - len(shell)) + shell[-2:]


def zstd(data):
    """`data` as one zstd frame, at default parameters (the TypeSafe SDK's)."""
    return compression.zstd.compress(data)


# One zstd frame, 11 bytes, decoding to `{}`. After the magic 28b52ffd: frame
# header descriptor 00 (no size, no checksum, window descriptor follows), window
# descriptor 88 (exponent 17: a 128 MiB window), then one raw last block, 3 byte
# header 110000 (size 2), payload 7b7d. The gateway's 16 MiB window cap refuses it.
WINDOW_128_MIB_FRAME = bytes.fromhex("28b52ffd00881100007b7d")
UNSUPPORTED_ENCODING = "llm-gateway: content-encoding not supported"


class RouteGateUnitTest(unittest.TestCase):
    """RV-024 F-1 probe, part 1: what route_gate refuses never reaches the
    app behind it."""

    def gate(self):
        inner = Recorder()
        return inner, gateway_hooks.route_gate(inner)

    def test_allowed_routes_reach_the_inner_app(self):
        for method, path in sorted(gateway_hooks.ROUTES):
            with self.subTest(method=method, path=path):
                inner, gate = self.gate()
                sent = call(gate, http(method, path, path.encode()))
                self.assertEqual(sent[0]["status"], 200)
                self.assertEqual(len(inner.scopes), 1)

    def test_raw_path_is_optional(self):
        inner, gate = self.gate()
        call(gate, http("POST", "/chat/completions"))
        self.assertEqual(len(inner.scopes), 1)

    def test_refused_requests_get_404_and_never_reach_the_inner_app(self):
        cases = [
            ("GET", "/health/liveness", b"/health/liveness"),
            ("GET", "/public/model_hub", b"/public/model_hub"),
            ("POST", "/key/generate", b"/key/generate"),
            ("POST", "/chat/completions/", b"/chat/completions/"),
            ("POST", "//chat/completions", b"//chat/completions"),
            ("POST", "/chat/completions", b"/chat%2Fcompletions"),
            ("POST", "/chat/completions", b"/chat%2fcompletions"),
            ("POST", "/v1/chat/completions", b"/v1/chat%2Fcompletions"),
            ("POST", "/chat/completions", b"/%63hat/completions"),
            ("POST", "/Chat/Completions", b"/Chat/Completions"),
            ("GET", "/V1/models", b"/V1/models"),
            ("GET", "/chat/completions", b"/chat/completions"),
            ("POST", "/models", b"/models"),
            ("HEAD", "/models", b"/models"),
            ("post", "/chat/completions", b"/chat/completions"),
            ("PUT", "/chat/completions", b"/chat/completions"),
            ("DELETE", "/v1/models", b"/v1/models"),
            ("POST", "/systemone", b"/systemone"),
            ("POST", "/v1/decisions", b"/v1/decisions"),
            ("POST", "/decisions", b"/decisions"),
            ("GET", "/v1/systemone", b"/v1/systemone"),
        ]
        for method, path, raw in cases:
            with self.subTest(method=method, raw_path=raw):
                inner, gate = self.gate()
                sent = call(gate, http(method, path, raw))
                self.assertEqual(sent[0]["status"], 404)
                self.assertIn(gateway_hooks.GATE_HEADER, sent[0]["headers"])
                self.assertEqual(sent[1]["body"], gateway_hooks.GATE_REFUSAL)
                self.assertEqual(inner.scopes, [])

    def test_lifespan_passes_through(self):
        inner, gate = self.gate()
        call(gate, {"type": "lifespan"})
        self.assertEqual([s["type"] for s in inner.scopes], ["lifespan"])

    def test_websocket_is_closed_without_reaching_the_inner_app(self):
        inner, gate = self.gate()
        sent = call(gate, {"type": "websocket", "path": "/chat/completions"})
        self.assertEqual(sent, [{"type": "websocket.close", "code": 1008}])
        self.assertEqual(inner.scopes, [])

    # the body guard: ROUTES' field sets, the decode, MAX_BODY_BYTES

    def guarded(self, chunks, scope=None):
        """Post `chunks` through the gate to a Reader: the inner app, the
        messages sent and the number of receive calls."""
        inner = Reader()
        sent, reads = call_with_body(
            gateway_hooks.route_gate(inner), scope or post(), chunks
        )
        return inner, sent, reads

