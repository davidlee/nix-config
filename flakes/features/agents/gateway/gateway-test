def price_now(model):
    """The packaged per-token rates of `model` now: LiteLLM prices a model
    with an off_peak_pricing block at that block's rates inside its UTC
    windows (llm_cost_calc/utils.py, 1.106.2). Only the clock is LiteLLM's;
    the rates are the map's."""
    from litellm.litellm_core_utils.llm_cost_calc.utils import _is_off_peak

    price = PRICE_MAP[model]
    off_peak = price.get("off_peak_pricing")
    return {**price, **off_peak} if off_peak and _is_off_peak(off_peak) else price


