def post_json(path, payload, key=None, via=None, headers=(), compress=False):
    """POST `payload` as JSON to the in-process app, or to the app `via` (an
    httpx client); `compress` sends it as one zstd frame (Content-Encoding)."""
    headers = {**({"Authorization": f"Bearer {key}"} if key else {}), **dict(headers)}
    if compress:
        return (via or client).post(
            path,
            headers={"Content-Type": "application/json", **headers}
            | {"Content-Encoding": "zstd"},
            content=zstd(json.dumps(payload).encode()),
        )
    return (via or client).post(path, headers=headers, json=payload)


