def served_by(config_dir, env):
    """The model_list entries whose key is read from `env`."""
    return [
        m
        for m in model_list(config_dir)
        if m["litellm_params"]["api_key"] == f"os.environ/{env}"
    ]


def refused_by_price_rule(config_dir):
    """The LiteLLM model ids a config dir serves without a cost source, by
    DEC-064 restated: the provider reports cost, or both prices are set, or
    the id is in the packaged price map."""

    def admitted(params):
        return (
            params["api_key"] in {f"os.environ/{env}" for env in REPORTS_COST}
            or {"input_cost_per_token", "output_cost_per_token"} <= params.keys()
            or params["model"] in PRICE_MAP
        )

    return [
        m["litellm_params"]["model"]
        for m in model_list(config_dir)
        if not admitted(m["litellm_params"])
    ]


# --- through a second app, on the fake config, against a fake OpenRouter -----

FAKE_COST = 0.0123  # the cost the fake reports; no price map has it


SYSTEMONE_USAGE = {"input_tokens": 1000, "output_tokens": 50}  # the fake's


class FakeUpstream:
    """The providers' endpoints on loopback. OpenRouter's chat completions
    (SL-014 EX-5): records each request body and answers it with usage.cost,
    streamed or not; the cost is left out when the body asks for no usage.
    TypeSafe's POST /v1/systemone (SL-019): records each request (path,
    headers, body) and answers with SYSTEMONE_USAGE and one answer per question."""

    def __init__(self, port):
        self.bodies = []  # chat completions
        self.systemone = []  # (headers, body) of each /v1/systemone request
        fake = self

        class Handler(BaseHTTPRequestHandler):
            def log_message(self, *args):
                pass

            def do_POST(self):
                length = int(self.headers["Content-Length"])
                body = json.loads(self.rfile.read(length))
                if self.path == "/v1/systemone":
                    headers = {k.lower(): v for k, v in self.headers.items()}
                    fake.systemone.append((headers, body))
                    self.reply("application/json", json.dumps(fake.answer(body)))
                    return
                fake.bodies.append(body)
                if body.get("stream"):
                    self.reply(
                        "text/event-stream",
                        "".join(f"data: {json.dumps(c)}\n\n" for c in fake.chunks(body))
                        + "data: [DONE]\n\n",
                    )
                else:
                    self.reply("application/json", json.dumps(fake.completion(body)))

            def reply(self, content_type, text):
                data = text.encode()
                self.send_response(200)
                self.send_header("Content-Type", content_type)
                self.send_header("Content-Length", str(len(data)))
                self.end_headers()
                self.wfile.write(data)

        # binds the port the fake config names; a clash fails loudly here
        self.server = ThreadingHTTPServer(("127.0.0.1", port), Handler)
        threading.Thread(target=self.server.serve_forever, daemon=True).start()

    def close(self):
        self.server.shutdown()
        self.server.server_close()

    def reset(self):
        self.bodies.clear()
        self.systemone.clear()

    @staticmethod
    def answer(body):
        """A SystemOneResponse: one noul answer per question."""
        answers = {name: {"type": "noul", "noul": 0.9} for name in body["questions"]}
        return {"model": body["model"], "answers": answers, "usage": SYSTEMONE_USAGE}

    @staticmethod
    def usage(body):
        usage = {"prompt_tokens": 10, "completion_tokens": 4, "total_tokens": 14}
        if body.get("usage", {}).get("include") is not False:
            usage["cost"] = FAKE_COST
        return usage

    @staticmethod
    def base(body, kind):
        return {"id": "fake", "created": 1, "model": body["model"], "object": kind}

    def completion(self, body):
        message = {"role": "assistant", "content": "OK"}
        return {
            **self.base(body, "chat.completion"),
            "choices": [{"index": 0, "message": message, "finish_reason": "stop"}],
            "usage": self.usage(body),
        }

    def chunks(self, body):
        def chunk(**fields):
            return {**self.base(body, "chat.completion.chunk"), **fields}

        delta = {"role": "assistant", "content": "OK"}
        yield chunk(choices=[{"index": 0, "delta": delta, "finish_reason": None}])
        yield chunk(choices=[{"index": 0, "delta": {}, "finish_reason": "stop"}])
        if body.get("stream_options", {}).get("include_usage") is not False:
            yield chunk(choices=[], usage=self.usage(body))


# The child's entry point: the launcher's app on the fake config, on a unix
# socket, unable to connect anywhere but loopback.
CHILD = """
import importlib.machinery, importlib.util, ipaddress, socket, sys

connect = socket.socket.connect


def loopback_only(sock, address):
    if isinstance(address, tuple) and not ipaddress.ip_address(address[0]).is_loopback:
        raise OSError(f"gateway-test: refused a connection to {address!r}")
    return connect(sock, address)


socket.socket.connect = loopback_only
launcher, config_dir, uds = sys.argv[1:]
loader = importlib.machinery.SourceFileLoader("llm_gateway_serve", launcher)
spec = importlib.util.spec_from_loader("llm_gateway_serve", loader)
serve = importlib.util.module_from_spec(spec)
loader.exec_module(serve)
import uvicorn

uvicorn.run(serve.app(config_dir), uds=uds, log_level="warning")
"""


class FakeGateway:
    """The fake config's app, served by a child process: a second config in
    this process would re-run LiteLLM's startup and register the Ledger
    twice. It shares this process's key store and provider variables."""

    START_WAIT = 120.0

    def __init__(self):
        self.upstream = FakeUpstream(FAKE_PORT)
        self.directory = tempfile.TemporaryDirectory()
        uds = str(Path(self.directory.name) / "gateway.sock")
        self.log = open(Path(self.directory.name) / "child.log", "w+")
        self.child = subprocess.Popen(
            [sys.executable, "-c", CHILD, str(SERVE), str(FAKE_CONFIG), uds],
            env={**os.environ, "CONFIG_FILE_PATH": str(FAKE_CONFIG / "config.yaml")},
            stdout=self.log,
            stderr=subprocess.STDOUT,
        )
        self.client = httpx.Client(
            transport=httpx.HTTPTransport(uds=uds),
            base_url="http://gateway",
            timeout=60,
        )
        self.wait_until_serving()

    def wait_until_serving(self):
        """Until an unauthenticated GET /v1/models gets custom_auth's 401."""
        deadline = time.monotonic() + self.START_WAIT
        while time.monotonic() < deadline and self.child.poll() is None:
            try:
                if self.client.get("/v1/models").status_code == 401:
                    return
            except httpx.TransportError:
                pass
            time.sleep(0.2)
        self.close()
        raise RuntimeError(f"fake gateway did not start:\n{self.output()}")

    def output(self):
        self.log.seek(0)
        return self.log.read()

    def close(self):
        self.client.close()
        self.child.terminate()
        self.child.wait(timeout=30)
        self.upstream.close()
        self.log.close()
        self.directory.cleanup()


