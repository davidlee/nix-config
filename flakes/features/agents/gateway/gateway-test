class FakeGateway:
    """The fake config's app, served by a child process: a second config in
    this process would re-run LiteLLM's startup and register the Ledger
    twice. It shares this process's key store and provider variables."""

    START_WAIT = 120.0

    def __init__(self):
        self.upstream = FakeOpenRouter(FAKE_PORT)
        self.directory = tempfile.TemporaryDirectory()
        uds = str(Path(self.directory.name) / "gateway.sock")
        self.log = open(Path(self.directory.name) / "child.log", "w+")
        self.child = subprocess.Popen(
            [sys.executable, "-c", CHILD, str(SERVE), str(FAKE_CONFIG), uds],
            env={**os.environ, "CONFIG_FILE_PATH": str(FAKE_CONFIG / "config.yaml")},
            stdout=self.log,
            stderr=subprocess.STDOUT,
        )
        self.client = httpx.Client(
            transport=httpx.HTTPTransport(uds=uds),
            base_url="http://gateway",
            timeout=60,
        )
        self.wait_until_serving()

    def wait_until_serving(self):
        """Until an unauthenticated GET /v1/models gets custom_auth's 401."""
        deadline = time.monotonic() + self.START_WAIT
        while time.monotonic() < deadline and self.child.poll() is None:
            try:
                if self.client.get("/v1/models").status_code == 401:
                    return
            except httpx.TransportError:
                pass
            time.sleep(0.2)
        self.close()
        raise RuntimeError(f"fake gateway did not start:\n{self.output()}")

    def output(self):
        self.log.seek(0)
        return self.log.read()

    def close(self):
        self.client.close()
        self.child.terminate()
        self.child.wait(timeout=30)
        self.upstream.close()
        self.log.close()
        self.directory.cleanup()


fake_gateway = None


def fake():
    """The fake gateway, started on first use and stopped with the module."""
    global fake_gateway
    if fake_gateway is None:
        fake_gateway = FakeGateway()
        unittest.addModuleCleanup(fake_gateway.close)
    fake_gateway.upstream.reset()
    return fake_gateway


REPORTED = "reported"  # an unmapped production OpenRouter model, on the fake
UNALLOWED = "unallowed"  # the same without allowed_openai_params


class OpenRouterCostTest(unittest.TestCase):
    """DEC-068: the cost OpenRouter reports reaches the Ledger, streamed and
    not, for a model the price map lacks."""

    def test_spend_rises_by_exactly_the_reported_cost(self):
        gateway = fake()
        key = issue("reporter", models=[REPORTED])
        for stream in (False, True):
            with self.subTest(stream=stream):
                gateway.upstream.reset()
                before = spent("reporter")
                response = chat(key, model=REPORTED, via=gateway.client, stream=stream)
                self.assertEqual(response.status_code, 200, response.text)
                if stream:
                    self.assertTrue(response.text.rstrip().endswith("data: [DONE]"))
                self.assertEqual(len(gateway.upstream.bodies), 1)
                assert_spend_rose_by("reporter", before, FAKE_COST)


class PassThroughTest(unittest.TestCase):
    """minuet's routing fields reach OpenRouter on an unmapped model: the
    provider preference (sort by throughput) as is, and reasoning_effort
    because the deployment allows it (allowed_openai_params)."""

    BODY = {"provider": {"sort": "throughput"}, "reasoning_effort": "none"}

    def test_provider_and_reasoning_effort_reach_the_upstream_body(self):
        gateway = fake()
        key = issue("passer", models=[REPORTED])
        response = chat(key, model=REPORTED, via=gateway.client, **self.BODY)
        self.assertEqual(response.status_code, 200, response.text)
        [body] = gateway.upstream.bodies
        self.assertEqual(body["provider"], {"sort": "throughput"})
        self.assertEqual(body["reasoning_effort"], "none")

    def test_twin_without_allowed_openai_params_gets_400_and_never_reaches_it(self):
        gateway = fake()
        key = issue("unallowed", models=[UNALLOWED])
        response = chat(key, model=UNALLOWED, via=gateway.client, **self.BODY)
        self.assertEqual(response.status_code, 400, response.text)
        self.assertIn("reasoning_effort", response.text)
        self.assertEqual(gateway.upstream.bodies, [])
        self.assertEqual(spent("unallowed"), 0)


class ParamsOverrideTest(unittest.TestCase):
    """DEC-070: a model's params merge under the generated model and key, so
    they add keys but cannot redirect it."""

    def test_params_cannot_replace_the_model_or_key(self):
