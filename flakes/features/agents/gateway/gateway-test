class ParserAgreementTest(unittest.TestCase):
    """ISS-020, SL-019 sec-6: LiteLLM parses a body by its Content-Type, so
    a JSON body sent as a form could reach it as fields the guard never saw.
    A polyglot whose message names a second loopback listener is served as
    the JSON the guard checked, by the configured upstream, whatever type
    the client declared."""

    CONTENT_TYPES = (
        "application/x-www-form-urlencoded",
        "multipart/form-data; boundary=b",
        "application/x-protobuf",
    )

    def test_a_polyglot_is_served_as_json_and_never_redirected(self):
        self.assert_served_as_json()

    def test_a_zstd_polyglot_is_served_as_json_and_never_redirected(self):
        """VT-2: the same body, zstd-encoded, is decoded before the guard and
        parsed as JSON whatever type the client declared."""
        self.assert_served_as_json(compress=True)

    def assert_served_as_json(self, **send):
        gateway = fake()
        elsewhere = FakeUpstream(0)
        self.addCleanup(elsewhere.close)
        port = elsewhere.server.server_address[1]
        content = (
            f"x&model={REPORTED}&api_base=http://127.0.0.1:{port}/v1"
            "&custom_llm_provider=openai&x="
        )
        key = issue(f"polyglot-{bool(send)}", models=[REPORTED])
        for content_type in self.CONTENT_TYPES:
            for path in ("/chat/completions", "/v1/chat/completions"):
                with self.subTest(content_type=content_type, path=path, **send):
                    gateway.upstream.reset()
                    response = chat(
                        key,
                        model=REPORTED,
                        path=path,
                        via=gateway.client,
                        headers={"Content-Type": content_type},
                        messages=[{"role": "user", "content": content}],
                        **send,
                    )
                    self.assertEqual(response.status_code, 200, response.text)
                    [body] = gateway.upstream.bodies
                    self.assertEqual(body["messages"][-1]["content"], content)
        self.assertEqual(elsewhere.bodies, [])


