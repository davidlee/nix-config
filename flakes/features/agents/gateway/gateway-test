def spend_after(alias, before, wait):
    """spent, once it moves off `before` or `wait` seconds have passed:
    success callbacks run after the response returns."""
    deadline = time.monotonic() + wait
    while spent(alias) == before and time.monotonic() < deadline:
        time.sleep(0.05)
    return spent(alias)


def assert_spend_raised(alias, wait=SPEND_WAIT):
    """The served request's cost reached the key store: spent > 0 within
    `wait` seconds. The one spend assertion, so its negative controls run it."""
    if spend_after(alias, 0, wait) <= 0:
        raise AssertionError(f"{alias}: spent not raised (spent_usd={spent(alias)})")


def assert_spend_rose_by(alias, before, amount, wait=SPEND_WAIT, settle=0.5):
    """spent rose from `before` by exactly `amount` within `wait` seconds,
    and stayed there `settle` seconds more (a second charge would show)."""
    spend_after(alias, before, wait)
    time.sleep(settle)
    delta = spent(alias) - before
    if abs(delta - amount) > 1e-12:
        raise AssertionError(f"{alias}: spent rose by {delta}, want {amount}")


def is_refusal(response, status, header):
    """A `status` answered by route_gate, not LiteLLM: it carries `header`
    (HEAD responses have no body to tell them apart by)."""
    name, value = (part.decode() for part in header)
    return response.status_code == status and response.headers.get(name) == value


def is_gate_refusal(response):
    return is_refusal(response, 404, gateway_hooks.GATE_HEADER)


def is_guard_refusal(response):
    return is_refusal(response, 400, gateway_hooks.GUARD_HEADER)


