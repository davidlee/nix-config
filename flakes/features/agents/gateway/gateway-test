        self.assertEqual(reads, 5)  # stops reading once over the cap

    def test_a_content_length_over_the_cap_gets_413_unread(self):
        length = str(gateway_hooks.MAX_BODY_BYTES + 1).encode()
        inner, sent, reads = self.guarded([b"{}"], post([(b"content-length", length)]))
        self.assert_refused(sent, inner, 413, "llm-gateway: request body too large")
        self.assertEqual(reads, 0)

    def test_a_body_exactly_at_the_cap_passes(self):
        cap = gateway_hooks.MAX_BODY_BYTES
        body = sized(cap)
        self.assertEqual(len(body), cap)
        length = [(b"content-length", str(cap).encode())]
        chunks = [body[i : i + cap // 3] for i in range(0, cap, cap // 3)]
        inner, sent, _ = self.guarded(chunks, post(length))
        self.assertEqual(sent[0]["status"], 200)
        self.assertEqual(inner.bodies, [body])

    # content-encoding: zstd is decoded within both bounds; every other
    # coding is refused (DEC-088)

    def zstd_headers(self, *extra):
        return post([(b"content-encoding", b"zstd"), *extra])

    def test_zstd_body_reaches_the_inner_app_decoded_with_canonical_headers(self):
        body = json.dumps(CLIENT_BODIES["pi"]).encode()
        packed = zstd(body)
        chunked = [(b"transfer-encoding", b"chunked")]
        for chunks, extra in (
            ([packed], []),
            ([packed[:7], packed[7:20], b"", packed[20:]], chunked),
        ):
            with self.subTest(chunks=len(chunks)):
                scope = self.zstd_headers(
                    (b"content-type", b"application/x-www-form-urlencoded"),
                    (b"content-length", str(len(packed)).encode()),
                    (b"authorization", b"Bearer k"),
                    *extra,
                )
                inner, sent, _ = self.guarded(chunks, scope)
                self.assertEqual(sent[0]["status"], 200)
                self.assertEqual(inner.bodies, [body])
                self.assertEqual(
                    inner.scopes[0]["headers"],
                    [
                        (b"authorization", b"Bearer k"),
                        (b"content-type", b"application/json"),
                        (b"content-length", str(len(body)).encode()),
                    ],
                )

    def test_zstd_encoding_is_matched_case_and_space_insensitively(self):
        for value in (b"ZSTD", b" zstd ", b"Zstd"):
            with self.subTest(value=value):
                scope = post([(b"content-encoding", value)])
                inner, sent, _ = self.guarded([zstd(b"{}")], scope)
                self.assertEqual(sent[0]["status"], 200)
                self.assertEqual(inner.bodies, [b"{}"])

    def test_identity_encoding_passes_as_plain(self):
        for value in (b"identity", b" Identity "):
            with self.subTest(value=value):
                scope = post([(b"content-encoding", value)])
                inner, sent, _ = self.guarded([b"{}"], scope)
                self.assertEqual(sent[0]["status"], 200)
                self.assertEqual(inner.bodies, [b"{}"])

    def test_zstd_other_codings_chains_and_repeats_get_415(self):
        zstd_body = zstd(b"{}")
        cases = {
            "gzip": [(b"content-encoding", b"gzip")],
            "br": [(b"content-encoding", b"br")],
            "zstd, identity": [(b"content-encoding", b"zstd, identity")],
            "identity, zstd": [(b"content-encoding", b"identity, zstd")],
            "zstd,": [(b"content-encoding", b"zstd,")],
            "two headers": [(b"content-encoding", b"zstd")] * 2,
            "zstd and identity headers": [
                (b"content-encoding", b"zstd"),
                (b"content-encoding", b"identity"),
            ],
        }
        for label, headers in cases.items():
            with self.subTest(label):
                inner, sent, _ = self.guarded([zstd_body], post(headers))
                self.assert_refused(sent, inner, 415, UNSUPPORTED_ENCODING)

    def test_zstd_an_oversize_encoded_body_is_413_before_the_encoding_is_judged(self):
        cap = gateway_hooks.MAX_BODY_BYTES
        scope = post([(b"content-encoding", b"gzip")])
        inner, sent, _ = self.guarded([b" " * (cap + 1)], scope)
        self.assert_refused(sent, inner, 413, "llm-gateway: request body too large")

    def test_zstd_bomb_gets_413_on_the_decoded_size(self):
        cap = gateway_hooks.MAX_BODY_BYTES
        packed = zstd(sized(cap + 1))
        self.assertLess(len(packed), cap)  # small on the wire
        inner, sent, _ = self.guarded([packed], self.zstd_headers())
        self.assert_refused(sent, inner, 413, "llm-gateway: request body too large")

    def test_zstd_body_decoding_to_exactly_the_cap_passes(self):
        cap = gateway_hooks.MAX_BODY_BYTES
        body = sized(cap)
        inner, sent, _ = self.guarded([zstd(body)], self.zstd_headers())
        self.assertEqual(sent[0]["status"], 200)
        self.assertEqual(inner.bodies, [body])

    def test_zstd_window_beyond_the_cap_gets_400(self):
        # control: the frame is valid; only its window is refused
        self.assertEqual(compression.zstd.decompress(WINDOW_128_MIB_FRAME), b"{}")
        inner, sent, _ = self.guarded([WINDOW_128_MIB_FRAME], self.zstd_headers())
        self.assert_refused(
            sent, inner, 400, "llm-gateway: zstd body does not decode"
        )

    def test_zstd_bodies_that_are_not_one_complete_frame_get_400(self):
        frame = zstd(b"{}")
        cases = {
            "truncated": frame[:-2],
            "two frames": frame + frame,
            "trailing bytes": frame + b"x",
            "empty": b"",
        }
        for label, packed in cases.items():
            with self.subTest(label):
                inner, sent, _ = self.guarded([packed], self.zstd_headers())
                self.assert_refused(
                    sent, inner, 400, "llm-gateway: zstd body is not one complete frame"
                )

    def test_zstd_garbage_gets_400(self):
        inner, sent, _ = self.guarded([b"not zstd at all"], self.zstd_headers())
        self.assert_refused(sent, inner, 400, "llm-gateway: zstd body does not decode")

    def test_zstd_body_still_gets_the_field_check_on_its_route(self):
        packed = zstd(json.dumps({"api_base": 1}).encode())
        inner, sent, _ = self.guarded([packed], self.zstd_headers())
        self.assert_refused(sent, inner, 400, "llm-gateway: field 'api_base' not allowed")
        state = zstd(json.dumps({"model": "m", "state": {}}).encode())
        for path, status in (("/v1/systemone", 200), ("/v1/chat/completions", 400)):
            with self.subTest(path=path):
                scope = post([(b"content-encoding", b"zstd")], path)
                _, sent, _ = self.guarded([state], scope)
                self.assertEqual(sent[0]["status"], status)


