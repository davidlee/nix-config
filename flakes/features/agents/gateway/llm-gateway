#!/usr/bin/env python3
"""llm-gateway: admin CLI for the gateway's key store, and the step that puts
provider keys where the service can load them (design SL-011 sec-4).

  llm-gateway issue <alias> --models a,b --budget USD [--out PATH]
  llm-gateway list | revoke <alias> | budget <alias> <USD> | reset <alias>
  llm-gateway credentials [provider ...]

Admin subcommands act on the key store as the service user, re-executing
themselves under `sudo -u llm-gateway` when run by anyone else (DEC-050).
`credentials` runs as you: `op read` is piped straight into
`sudo systemd-creds encrypt`, so the provider key never touches argv, a file
in clear, or this process's memory (DEC-048).

sudo drops the environment, so nothing here reads it: configuration is baked
in below, and everything else travels as argv. No key ever does.
"""

import argparse
import dataclasses
import io
import os
import pwd
import subprocess
import sys
import tempfile
from collections.abc import Callable
from pathlib import Path
from typing import TextIO

sys.path.insert(0, str(Path(__file__).resolve().parent))
import keystore

# Baked configuration: the single seam for the NixOS record, which replaces
# these lines from its `models` and `providers` options when it installs this
# script (features/agents/gateway.nix). The values here are the tests'.
MODELS = ("deepseek-flash",)
PROVIDERS = {"deepseek": "op://API_KEYS/DEEPSEEK_API_KEY/credential"}
DB = "/var/lib/llm-gateway/keys.db"

SERVICE_USER = "llm-gateway"
CREDSTORE = "/etc/credstore.encrypted"


@dataclasses.dataclass(frozen=True)
class Config:
    models: tuple
    providers: dict  # provider name -> op:// reference
    db: str


@dataclasses.dataclass(frozen=True)
class Host:
    """Everything the CLI takes from the machine, so tests can stand in for
    sudo, the service user, processes and the terminal."""

    config: Config
    is_service_user: Callable[[], bool]
    privileged: Callable[
        [list], tuple
    ]  # argv -> (exit code, stdout) as the service user
    spawn: Callable[..., subprocess.Popen]  # subprocess.Popen(argv, stdin=, stdout=)
    out: TextIO
    err: TextIO


def production_host():
    self_path = str(Path(__file__).resolve())

    def privileged(args):
        done = subprocess.run(
            ["sudo", "-u", SERVICE_USER, "--", self_path, *args],
            stdout=subprocess.PIPE,
            text=True,
            check=False,
        )
        return done.returncode, done.stdout

    return Host(
        config=Config(MODELS, PROVIDERS, DB),
        is_service_user=lambda: pwd.getpwuid(os.geteuid()).pw_name == SERVICE_USER,
        privileged=privileged,
        spawn=subprocess.Popen,
        out=sys.stdout,
        err=sys.stderr,
    )


class UsageError(Exception):
    pass


class Parser(argparse.ArgumentParser):
    """Reports usage errors to the caller instead of exiting, so they reach
    `Host.err`."""

    def error(self, message):
        raise UsageError(message)


def model_list(text):
    names = [name for name in text.split(",") if name]
    if not names:
        raise ValueError(text)
    return names


def parser():
    top = Parser(prog="llm-gateway")
    commands = top.add_subparsers(dest="command", required=True)
    issue = commands.add_parser(
        "issue", help="issue a key; prints it once, or writes it to --out"
    )
    issue.add_argument("alias")
    issue.add_argument(
        "--models",
        type=model_list,
        required=True,
        help="comma-separated gateway model names",
    )
    issue.add_argument(
        "--budget", type=keystore.usd, required=True, help="lifetime budget in USD"
    )
    issue.add_argument(
        "--out", type=Path, help="write the key to this new file (mode 0600) instead"
    )
    commands.add_parser("list", help="every key: alias, models, budget, spent, revoked")
    commands.add_parser("revoke").add_argument("alias")
    budget = commands.add_parser("budget", help="set a key's lifetime budget")
    budget.add_argument("alias")
    budget.add_argument("usd", type=keystore.usd)
    commands.add_parser("reset", help="set a key's spend back to 0").add_argument(
        "alias"
    )
    credentials = commands.add_parser(
        "credentials", help="encrypt provider keys from 1Password for the service"
    )
    credentials.add_argument("providers", nargs="*")
    return top


def main(argv, *, host):
    try:
        args = parser().parse_args(argv)
    except UsageError as error:
        return fail(host, error)
    if args.command == "credentials":
        return credentials(host, args.providers)
    if args.command == "issue":
        unknown = sorted(set(args.models) - set(host.config.models))
        if unknown:
            return fail(
                host,
                f"unknown models: {', '.join(unknown)} (configured: {', '.join(host.config.models)})",
            )
        if args.out:
            return issue_to_file(host, args)
    code, text = as_service(host, argv)
    host.out.write(text)
    return code


def fail(host, message, code=2):
    print(f"llm-gateway: {message}", file=host.err)
    return code


def as_service(host, argv):
    """Run an admin command as the service user: (exit code, stdout)."""
    if not host.is_service_user():
        return host.privileged(argv)
    out = io.StringIO()
    return administer(
        dataclasses.replace(host, out=out), parser().parse_args(argv)
    ), out.getvalue()


def administer(host, args):
    db = host.config.db
    try:
        if args.command == "issue":
            print(
                keystore.issue(db, args.alias, args.models, args.budget), file=host.out
            )
        elif args.command == "list":
            print_rows(host.out, keystore.rows(db))
        elif args.command == "revoke":
            keystore.revoke(db, args.alias)
        elif args.command == "budget":
            keystore.set_budget(db, args.alias, args.usd)
        elif args.command == "reset":
            keystore.reset_spend(db, args.alias)
    except keystore.KeyStoreError as error:
        return fail(host, error, code=1)
    return 0


def print_rows(out, rows):
    print("alias\tmodels\tbudget_usd\tspent_usd\trevoked", file=out)
    for row in rows:
        fields = (
            row["alias"],
            ",".join(row["models"]),
            f"{row['budget_usd']:.4f}",
            f"{row['spent_usd']:.4f}",
            row["revoked_at"] or "-",
        )
        print("\t".join(fields), file=out)


def issue_to_file(host, args):
    """issue --out (RV-024 F-6): this unprivileged parent checks the
    destination, has the service user issue the key, then publishes it. If
    publishing fails, the key is revoked, so no live key exists that nobody
    holds. The alias stays taken (see keystore)."""
    dest = args.out.absolute()
    try:
        prepare(dest)
    except OSError as error:
        return fail(
            host,
            f"{args.alias}: cannot write {dest}: {error.strerror or error}",
            code=1,
        )
    issue_argv = [
        "issue",
        args.alias,
        "--models",
        ",".join(args.models),
        "--budget",
        repr(args.budget),
    ]
    code, key = as_service(host, issue_argv)
    if code != 0:
        return code
    try:
        publish(dest, key.strip() + "\n")
    except BaseException as error:
        revoked = as_service(host, ["revoke", args.alias])[0] == 0
        outcome = (
            "key revoked"
            if revoked
            else f"REVOKE FAILED: run `llm-gateway revoke {args.alias}`"
        )
        fail(host, f"{args.alias}: could not write {dest} ({error}); {outcome}", code=1)
        if not isinstance(error, Exception):
            raise
        return 1
    print(f"{args.alias}: key written to {dest}", file=host.out)
    return 0


def prepare(dest):
    """Refuse an existing destination (a dangling symlink included); create
    its directory 0700 if absent; require it writable."""
    if os.path.lexists(dest):
        raise FileExistsError(17, "already exists; refusing to overwrite")
    if not dest.parent.exists():
        dest.parent.mkdir(parents=True)
        dest.parent.chmod(0o700)  # mkdir's mode is subject to umask
    if not os.access(dest.parent, os.W_OK | os.X_OK):
        raise PermissionError(13, "directory not writable")


def publish(dest, text):
    """Write a 0600 temp file beside `dest`, then hard-link it into place:
    atomic like rename, but refuses a destination that appeared meanwhile."""
    fd, tmp = tempfile.mkstemp(dir=dest.parent, prefix=f".{dest.name}.")
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w") as file:
            file.write(text)
            file.flush()
            os.fsync(file.fileno())
        os.link(tmp, dest)
    finally:
        os.unlink(tmp)


def encrypt_argv(provider):
    # --name must equal the service's LoadCredentialEncrypted id: systemd
    # checks the name embedded in the credential.
    return [
        "sudo",
        "systemd-creds",
        "encrypt",
        "--with-key=host+tpm2",
        f"--name={provider}",
        "-",
        f"{CREDSTORE}/{SERVICE_USER}.{provider}",
    ]


def credentials(host, names):
    """For each provider, `op read` (as you) piped into `systemd-creds
    encrypt` (as root); then one restart. This process never reads the key."""
    providers = host.config.providers
    unknown = [name for name in names if name not in providers]
    if unknown:
        return fail(
            host,
            f"unknown providers: {', '.join(unknown)} (configured: {', '.join(providers)})",
        )
    for name in names or providers:
        op = host.spawn(
            ["op", "read", "--no-newline", providers[name]], stdout=subprocess.PIPE
        )
        encrypt = host.spawn(encrypt_argv(name), stdin=op.stdout)
        op.stdout.close()
        steps = {"systemd-creds encrypt": encrypt.wait(), "op read": op.wait()}
        failed = [step for step, code in steps.items() if code != 0]
        if failed:
            return fail(
                host,
                f"{name}: {' and '.join(failed)} failed; service not restarted",
                code=1,
            )
    if host.spawn(["sudo", "systemctl", "restart", SERVICE_USER]).wait() != 0:
        return fail(
            host, "credentials written; systemctl restart llm-gateway failed", code=1
        )
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:], host=production_host()))
