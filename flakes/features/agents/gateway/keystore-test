#!/usr/bin/env python3
"""Behaviour tests for the gateway key store and the llm-gateway admin CLI.
No sudo, no LiteLLM, no server, no 1Password: every case runs against a temp
database, and the CLI's privileged step, process runner and streams are
injected (a `Host`). Secrets are sentinels, and cases assert they never reach
an argv or an output stream.

  ./keystore-test [-v]
"""

import contextlib
import hashlib
import importlib.machinery
import importlib.util
import io
import os
import socket
import sqlite3
import stat
import subprocess
import sys
import tempfile
import unittest
from pathlib import Path
from unittest import mock

here = Path(__file__).resolve().parent
sys.path.insert(0, str(here))
import keystore

loader = importlib.machinery.SourceFileLoader("llm_gateway", str(here / "llm-gateway"))
spec = importlib.util.spec_from_loader("llm_gateway", loader)
gateway = importlib.util.module_from_spec(spec)
loader.exec_module(gateway)

MALFORMED_MONEY = [
    "nan",
    "NaN",
    float("nan"),
    "inf",
    "-inf",
    float("inf"),
    float("-inf"),
    -1,
    "-0.01",
    "abc",
    "",
    None,
    True,
]
PROVIDER_SECRET = "SENTINEL-provider-key-never-in-argv"
READY_PROBE = ["sudo", "test", "-S", "/run/llm-gateway/api.sock"]
RESTART = [
    ["sudo", "systemctl", "reset-failed", "llm-gateway"],
    ["sudo", "systemctl", "restart", "llm-gateway"],
]
CONFIG = gateway.Config(
    models=("model-a", "model-b"),
    providers={
        "alpha": "op://vault/alpha/credential",
        "beta": "op://vault/beta/credential",
    },
    db="",
    credstore="/etc/credstore.encrypted",
    socket="/run/llm-gateway/api.sock",
)


class TempStore(unittest.TestCase):
    """A fresh key store per case, removed afterwards."""

    def setUp(self):
        self.dir = tempfile.TemporaryDirectory()
        self.addCleanup(self.dir.cleanup)
        self.db = str(Path(self.dir.name) / "keys.db")

    def issue(self, alias="eca", models=("model-a",), budget=5):
        return keystore.issue(self.db, alias, list(models), budget)

    def table(self):
        with keystore.transaction(self.db) as conn:
            return [dict(row) for row in conn.execute("select * from keys")]

    def row(self, alias="eca"):
        return next(row for row in self.table() if row["alias"] == alias)


class Usd(unittest.TestCase):
    def test_usd_refuses_nan_inf_negative_and_non_numbers(self):
        for value in MALFORMED_MONEY:
            with self.subTest(value=value), self.assertRaises(ValueError):
                keystore.usd(value)

    def test_usd_accepts_finite_non_negative_amounts(self):
        for value, expected in [(0, 0.0), ("5", 5.0), (2.5, 2.5), (" 0.25 ", 0.25)]:
            with self.subTest(value=value):
                self.assertEqual(keystore.usd(value), expected)
                self.assertIs(type(keystore.usd(value)), float)


class Schema(TempStore):
    def test_store_is_in_wal_mode(self):
        self.issue()
        with contextlib.closing(sqlite3.connect(self.db)) as conn:
            self.assertEqual(conn.execute("pragma journal_mode").fetchone()[0], "wal")

    def test_check_refuses_a_direct_negative_write_with_IntegrityError(self):
        self.issue()
        with contextlib.closing(sqlite3.connect(self.db)) as conn:
            for column in ("budget_usd", "spent_usd"):
                with (
                    self.subTest(column=column),
                    self.assertRaises(sqlite3.IntegrityError),
                ):
                    conn.execute(f"update keys set {column} = -1")
            with self.assertRaises(sqlite3.IntegrityError):
                conn.execute(
                    "insert into keys(hash, alias, models, budget_usd, created) values ('h', 'x', '[]', -1, 'now')"
                )


class Issue(TempStore):
    def test_issue_returns_the_key_once_and_stores_only_its_hash(self):
        key = self.issue()
        row = self.row()
        self.assertEqual(row["hash"], hashlib.sha256(key.encode()).hexdigest())
        for column, value in row.items():
            self.assertNotIn(key, str(value), column)
        self.assertNotIn(key.encode(), Path(self.db).read_bytes())

    def test_issued_keys_carry_the_sk_prefix(self):
        # LiteLLM hashes only sk- keys on its logging and failure paths
        # (RV-026 F-3).
        self.assertTrue(self.issue().startswith("sk-"))

    def test_each_issue_returns_a_new_key(self):
        self.assertNotEqual(self.issue("one"), self.issue("two"))

    def test_issue_refuses_a_duplicate_alias_naming_it(self):
        self.issue()
        with self.assertRaisesRegex(keystore.KeyStoreError, "eca"):
            self.issue()

    def test_a_revoked_alias_cannot_be_reissued(self):
        self.issue()
        keystore.revoke(self.db, "eca")
        with self.assertRaises(keystore.KeyStoreError):
            self.issue()

    def test_issue_refuses_an_empty_model_list(self):
        with self.assertRaises(keystore.KeyStoreError):
            self.issue(models=())
        self.assertEqual(self.table(), [])

    def test_issue_refuses_malformed_budget_and_writes_no_row(self):
        for value in MALFORMED_MONEY:
            with self.subTest(value=value), self.assertRaises(ValueError):
                self.issue(budget=value)
        self.assertEqual(self.table(), [])


class Authenticate(TempStore):
    def test_authenticate_accepts_a_live_key_and_returns_its_row(self):
        key = self.issue(models=("model-a", "model-b"))
        row = keystore.authenticate(self.db, key)
        self.assertEqual(row["alias"], "eca")
        self.assertEqual(row["models"], ["model-a", "model-b"])
        self.assertEqual(row["hash"], keystore.key_hash(key))

    def test_authenticate_refuses_an_unknown_key(self):
        self.issue()
        with self.assertRaises(keystore.Refused):
            keystore.authenticate(self.db, "not-a-key")

    def test_authenticate_refuses_a_revoked_key_naming_the_alias(self):
        key = self.issue()
        keystore.revoke(self.db, "eca")
        with self.assertRaisesRegex(keystore.Refused, "eca: revoked") as refused:
            keystore.authenticate(self.db, key)
        self.assertNotIn(key, str(refused.exception))

    def test_authenticate_refuses_a_zero_budget(self):
        key = self.issue(budget=0)
        with self.assertRaisesRegex(keystore.Refused, "budget"):
            keystore.authenticate(self.db, key)

    def test_allows_model_only_for_listed_models(self):
        row = keystore.authenticate(self.db, self.issue(models=("model-a",)))
        self.assertTrue(keystore.allows_model(row, "model-a"))
        self.assertFalse(keystore.allows_model(row, "model-b"))


class RecordSpend(TempStore):
    def test_record_spend_accrues_until_the_key_is_refused(self):
        key = self.issue(budget=1)
        digest = keystore.key_hash(key)
        keystore.record_spend(self.db, digest, 0.25)
        keystore.record_spend(self.db, digest, 0.5)
        self.assertEqual(self.row()["spent_usd"], 0.75)
        keystore.authenticate(self.db, key)
        keystore.record_spend(self.db, digest, 0.25)
        with self.assertRaisesRegex(keystore.Refused, "budget"):
            keystore.authenticate(self.db, key)

    def test_record_spend_counts_malformed_cost_as_zero_with_a_warning(self):
        key = self.issue()
        digest = keystore.key_hash(key)
        for cost in MALFORMED_MONEY:
            with (
                self.subTest(cost=cost),
                self.assertLogs(keystore.log, "WARNING") as logs,
            ):
                keystore.record_spend(self.db, digest, cost)
            self.assertIn("eca", logs.output[0])
            self.assertNotIn(key, logs.output[0])
            self.assertNotIn(digest, logs.output[0])
        self.assertEqual(self.row()["spent_usd"], 0)

    def test_record_spend_on_an_unknown_hash_warns_and_changes_nothing(self):
        self.issue()
        with self.assertLogs(keystore.log, "WARNING") as logs:
            keystore.record_spend(self.db, "0" * 64, 1)
        self.assertNotIn("0" * 64, logs.output[0])
        self.assertEqual(self.row()["spent_usd"], 0)


class Admin(TempStore):
    def test_revoke_marks_the_row_and_keeps_it(self):
        self.issue()
        keystore.revoke(self.db, "eca")
        self.assertIsNotNone(self.row()["revoked_at"])

    def test_set_budget_changes_the_budget(self):
        key = self.issue(budget=0)
        keystore.set_budget(self.db, "eca", "2.5")
        self.assertEqual(self.row()["budget_usd"], 2.5)
        keystore.authenticate(self.db, key)

    def test_set_budget_refuses_malformed_money_and_leaves_the_budget(self):
        self.issue(budget=3)
        for value in MALFORMED_MONEY:
            with self.subTest(value=value), self.assertRaises(ValueError):
                keystore.set_budget(self.db, "eca", value)
        self.assertEqual(self.row()["budget_usd"], 3)

    def test_reset_spend_returns_spent_to_zero(self):
        key = self.issue(budget=1)
        keystore.record_spend(self.db, keystore.key_hash(key), 1)
        keystore.reset_spend(self.db, "eca")
        self.assertEqual(self.row()["spent_usd"], 0)
        keystore.authenticate(self.db, key)

    def test_admin_on_an_unknown_alias_is_refused_naming_it(self):
        for act in (
            lambda: keystore.revoke(self.db, "ghost"),
            lambda: keystore.set_budget(self.db, "ghost", 1),
            lambda: keystore.reset_spend(self.db, "ghost"),
        ):
            with self.assertRaisesRegex(keystore.KeyStoreError, "ghost"):
                act()

    def test_rows_lists_every_key_without_its_hash(self):
        self.issue("one", models=("model-a", "model-b"), budget=2)
        self.issue("two")
        rows = keystore.rows(self.db)
        self.assertEqual([row["alias"] for row in rows], ["one", "two"])
        self.assertEqual(rows[0]["models"], ["model-a", "model-b"])
        self.assertEqual(rows[0]["budget_usd"], 2)
        for row in rows:
            self.assertNotIn("hash", row)


class FakeProcess:
    """What `Host.spawn` returns: an exit code and, if piped, a stdout handle."""

    def __init__(self, argv, stdin, returncode):
        self.argv, self.stdin, self.returncode = argv, stdin, returncode
        self.stdout = io.BytesIO(PROVIDER_SECRET.encode()) if argv[0] == "op" else None

    def wait(self):
        return self.returncode


class FakeHost:
    """A user-side Host whose privileged step runs the CLI in-process as the
    service user against the temp store: a real parent/child round trip, no sudo."""

    def __init__(self, db, failing=(), unready=0):
        self.calls, self.spawned, self.sleeps = [], [], []
        self.failing, self.unready = failing, unready
        config = gateway.dataclasses.replace(CONFIG, db=db)

        def side(is_service_user, privileged):
            return gateway.Host(
                config=config,
                is_service_user=lambda: is_service_user,
                privileged=privileged,
                spawn=self.spawn,
                sleep=self.sleeps.append,
                out=io.StringIO(),
                err=io.StringIO(),
            )

        self.service = side(True, self.no_privileged)
        self.user = side(False, self.privileged)

    def privileged(self, args):
        self.calls.append(list(args))
        out = io.StringIO()
        code = gateway.main(
            args, host=gateway.dataclasses.replace(self.service, out=out)
        )
        return code, out.getvalue()

    def no_privileged(self, args):
        raise AssertionError("the service user never re-execs")

    def spawn(self, argv, stdin=None, stdout=None):
        failed = any(tuple(argv[: len(p)]) == p for p in self.failing)
        if argv == READY_PROBE and self.unready:
            self.unready -= 1
            failed = True
        process = FakeProcess(argv, stdin, 1 if failed else 0)
        self.spawned.append(process)
        return process

    def run(self, *argv, as_service=False):
        host = self.service if as_service else self.user
        return gateway.main(list(argv), host=host)

    @property
    def out(self):
        return self.user.out.getvalue()

    @property
    def err(self):
        return self.user.err.getvalue() + self.service.err.getvalue()


class Cli(TempStore):
    def setUp(self):
        super().setUp()
        self.host = FakeHost(self.db)

    def test_admin_subcommands_reexec_as_the_service_user_with_the_same_args(self):
        for argv in (
            ["issue", "eca", "--models", "model-a", "--budget", "5"],
            ["list"],
            ["budget", "eca", "2"],
            ["reset", "eca"],
            ["revoke", "eca"],
        ):
            with self.subTest(argv=argv):
                self.assertEqual(self.host.run(*argv), 0, self.host.err)
                self.assertEqual(self.host.calls[-1], argv)

    def test_issue_prints_the_key_exactly_once(self):
        self.host.run("issue", "eca", "--models", "model-a,model-b", "--budget", "5")
        key = self.host.out.strip()
        self.assertEqual(
            keystore.authenticate(self.db, key)["models"], ["model-a", "model-b"]
        )
        self.assertEqual(self.host.out, key + "\n")

    def test_cli_budget_argument_refuses_nan_and_inf_before_any_reexec(self):
        for argv in (
            ["budget", "eca", "nan"],
            ["budget", "eca", "-1"],
            ["issue", "eca", "--models", "model-a", "--budget", "inf"],
            ["issue", "eca", "--models", "model-a", "--budget", "NaN"],
        ):
            with self.subTest(argv=argv):
                self.assertNotEqual(self.host.run(*argv), 0)
                self.assertIn("usd", self.host.err)
        self.assertEqual(self.host.calls, [])
        self.assertEqual(self.table(), [])

    def test_issue_refuses_unknown_model_names_before_any_reexec(self):
        self.assertNotEqual(
            self.host.run("issue", "eca", "--models", "model-a,nope", "--budget", "1"),
            0,
        )
        self.assertIn("nope", self.host.err)
        self.assertEqual(self.host.calls, [])

    def test_list_shows_alias_models_budget_spent_revoked_and_no_hash(self):
        key = self.issue("eca", models=("model-a", "model-b"), budget=5)
        self.issue("old")
        keystore.revoke(self.db, "old")
        self.assertEqual(self.host.run("list", as_service=True), 0)
        out = self.host.service.out.getvalue()
        self.assertRegex(out, r"eca\s+model-a,model-b\s+5\.0+\s+0\.0+\s+-")
        self.assertRegex(out, r"old\s+model-a\s+5\.0+\s+0\.0+\s+\d{4}-")
        self.assertNotIn(keystore.key_hash(key), out)
        self.assertNotIn(key, out)

    def test_admin_error_names_the_alias_and_exits_non_zero(self):
        self.assertNotEqual(self.host.run("revoke", "ghost"), 0)
        self.assertIn("ghost", self.host.err)


class IssueOut(TempStore):
    """issue --out: the unprivileged parent writes the file (RV-024 F-6)."""

    def setUp(self):
        super().setUp()
        self.host = FakeHost(self.db)
        self.dest = Path(self.dir.name) / "home" / "keys" / "eca"

    def issue_out(self):
        return self.host.run(
            "issue",
            "eca",
            "--models",
            "model-a",
            "--budget",
            "5",
            "--out",
            str(self.dest),
        )

    def leftovers(self):
        return (
            sorted(p.name for p in self.dest.parent.iterdir())
            if self.dest.parent.exists()
            else []
        )

    def test_out_writes_a_0o600_file_holding_a_live_key_in_a_0700_directory(self):
        self.assertEqual(self.issue_out(), 0, self.host.err)
        self.assertEqual(stat.S_IMODE(self.dest.stat().st_mode), 0o600)
        self.assertEqual(stat.S_IMODE(self.dest.parent.stat().st_mode), 0o700)
        key = self.dest.read_text()
        self.assertTrue(key.startswith("sk-"))
        self.assertTrue(key.endswith("\n"))
        self.assertEqual(keystore.authenticate(self.db, key.strip())["alias"], "eca")
        self.assertNotIn(key.strip(), self.host.out + self.host.err)
        self.assertEqual(self.leftovers(), ["eca"])
        self.assertEqual(
            self.host.calls,
            [["issue", "eca", "--models", "model-a", "--budget", "5.0"]],
        )

    def test_out_creates_every_missing_directory_0700_whatever_the_umask(self):
        Path(self.dir.name).chmod(0o755)  # exists: left as it is
        old = os.umask(0o022)
        try:
            self.assertEqual(self.issue_out(), 0, self.host.err)
        finally:
            os.umask(old)
        for directory in (self.dest.parent, self.dest.parent.parent):
            with self.subTest(directory=directory.name):
                self.assertEqual(stat.S_IMODE(directory.stat().st_mode), 0o700)
        self.assertEqual(stat.S_IMODE(Path(self.dir.name).stat().st_mode), 0o755)

    def test_out_refuses_an_existing_destination_before_any_key_is_issued(self):
        self.dest.parent.mkdir(parents=True)
        self.dest.write_text("keep me")
        self.assertNotEqual(self.issue_out(), 0)
        self.assertIn(str(self.dest), self.host.err)
        self.assertEqual(self.dest.read_text(), "keep me")
        self.assertEqual(self.host.calls, [])
        self.assertEqual(self.table(), [])

    def test_out_refuses_a_dangling_symlink_destination(self):
        self.dest.parent.mkdir(parents=True)
        self.dest.symlink_to(self.dest.parent / "elsewhere")
        self.assertNotEqual(self.issue_out(), 0)
        self.assertEqual(self.host.calls, [])

    def test_write_failure_after_issue_revokes_the_key_and_leaves_no_file(self):
        with mock.patch.object(
            gateway.os, "link", side_effect=OSError(28, "No space left on device")
        ):
            self.assertNotEqual(self.issue_out(), 0)
        self.assertEqual(self.host.calls[-1], ["revoke", "eca"])
        self.assertIsNotNone(self.row()["revoked_at"])
        self.assertEqual(self.leftovers(), [])
        self.assertIn("eca", self.host.err)
        self.assertIn("revoked", self.host.err)

    def test_out_as_the_service_user_issues_in_process(self):
        self.assertEqual(
            self.host.run(
                "issue",
                "eca",
                "--models",
                "model-a",
                "--budget",
                "5",
                "--out",
                str(self.dest),
                as_service=True,
            ),
            0,
            self.host.err,
        )
        self.assertEqual(
            keystore.authenticate(self.db, self.dest.read_text().strip())["alias"],
            "eca",
        )
        self.assertEqual(self.host.calls, [])


def staged(provider):
    return f"/etc/credstore.encrypted/llm-gateway.{provider}.new"


def stored(provider):
    return f"/etc/credstore.encrypted/llm-gateway.{provider}"


class Credentials(unittest.TestCase):
    def setUp(self):
        self.host = FakeHost("/nonexistent/keys.db")

    def argvs(self):
        return [process.argv for process in self.host.spawned]

    def assert_no_secret_leaked(self):
        for argv in self.argvs():
            self.assertNotIn(PROVIDER_SECRET, " ".join(argv))
        self.assertNotIn(PROVIDER_SECRET, self.host.out + self.host.err)

    def test_stages_each_credential_installs_it_then_restarts_once_and_waits(self):
        self.assertEqual(self.host.run("credentials"), 0, self.host.err)
        self.assertEqual(
            self.argvs(),
            [
                ["op", "read", "--no-newline", "op://vault/alpha/credential"],
                gateway.encrypt_argv("alpha", staged("alpha")),
                ["sudo", "mv", "-f", "--", staged("alpha"), stored("alpha")],
                ["op", "read", "--no-newline", "op://vault/beta/credential"],
                gateway.encrypt_argv("beta", staged("beta")),
                ["sudo", "mv", "-f", "--", staged("beta"), stored("beta")],
                *RESTART,
                READY_PROBE,
            ],
        )
        self.assertEqual(
            gateway.encrypt_argv("alpha", staged("alpha")),
            [
                "sudo",
                "systemd-creds",
                "encrypt",
                "--with-key=host+tpm2",
                "--name=alpha",
                "-",
                staged("alpha"),
            ],
        )
        op, encrypt = self.host.spawned[:2]
        self.assertIs(encrypt.stdin, op.stdout)
        self.assertTrue(op.stdout.closed, "the parent's copy of op's stdout is closed")
        self.assert_no_secret_leaked()
        self.assertEqual(self.host.calls, [])

    def test_named_provider_only(self):
        self.assertEqual(self.host.run("credentials", "beta"), 0)
        self.assertEqual(self.argvs()[0][-1], "op://vault/beta/credential")
        self.assertEqual(len(self.argvs()), 6)

    def test_unknown_provider_is_refused_before_anything_runs(self):
        self.assertNotEqual(self.host.run("credentials", "alpha", "gamma"), 0)
        self.assertIn("gamma", self.host.err)
        self.assertEqual(self.argvs(), [])

    def test_a_failed_step_discards_the_staged_file_and_skips_the_restart(self):
        for failing in (("op", "read"), ("sudo", "systemd-creds")):
            with self.subTest(failing=failing):
                self.host = FakeHost("/nonexistent/keys.db", failing=(failing,))
                self.assertNotEqual(self.host.run("credentials"), 0)
                self.assertIn("alpha", self.host.err)
                self.assertIn(failing[-1], self.host.err)
                self.assertIn("unchanged", self.host.err)
                self.assertEqual(
                    self.argvs()[-1], ["sudo", "rm", "-f", "--", staged("alpha")]
                )
                for argv in self.argvs():
                    self.assertNotEqual(argv[:2], ["sudo", "mv"])
                    self.assertNotIn(argv, RESTART)
                self.assert_no_secret_leaked()

    def test_waits_for_the_socket_after_the_restart(self):
        self.host = FakeHost("/nonexistent/keys.db", unready=3)
        self.assertEqual(self.host.run("credentials", "alpha"), 0, self.host.err)
        self.assertEqual(self.argvs()[-4:], [READY_PROBE] * 4)
        self.assertEqual(len(self.host.sleeps), 3)

    def test_a_gateway_that_never_comes_up_fails_naming_the_unit(self):
        self.host = FakeHost("/nonexistent/keys.db", failing=(tuple(READY_PROBE),))
        self.assertEqual(self.host.run("credentials", "alpha"), 1)
        self.assertLessEqual(sum(self.host.sleeps), gateway.READY_TIMEOUT)
        self.assertGreater(len(self.host.sleeps), 1)
        self.assertIn("systemctl status llm-gateway", self.host.err)

    def test_a_failed_restart_is_reported_and_not_waited_for(self):
        self.host = FakeHost("/nonexistent/keys.db", failing=(tuple(RESTART[1]),))
        self.assertEqual(self.host.run("credentials", "alpha"), 1)
        self.assertIn("restart", self.host.err)
        self.assertNotIn(READY_PROBE, self.argvs())


class CredentialsOnDisk(unittest.TestCase):
    """The production runner against real files: stub `op`, `sudo` (runs its
    command), `systemd-creds` (copies stdin, standing in for encryption) and
    `systemctl` on PATH; mv, rm and test are the real ones."""

    def setUp(self):
        tmp = tempfile.TemporaryDirectory()
        self.addCleanup(tmp.cleanup)
        self.tmp = Path(tmp.name)
        self.bin = self.tmp / "bin"
        self.credstore = self.tmp / "credstore"
        self.bin.mkdir()
        self.credstore.mkdir()
        self.stored = self.credstore / "llm-gateway.alpha"
        socket_path = self.tmp / "api.sock"
        listener = socket.socket(socket.AF_UNIX)
        self.addCleanup(listener.close)
        listener.bind(str(socket_path))
        stubs = {
            "op": f'#!/bin/sh\n[ -n "$OP_FAIL" ] && exit 1\nprintf %s "{PROVIDER_SECRET}"\n',
            "sudo": f'#!/bin/sh\necho "$*" >> {self.tmp}/argv\nexec "$@"\n',
            "systemd-creds": '#!/bin/sh\nfor last; do :; done\ncat > "$last"\n',
            "systemctl": "#!/bin/sh\nexit 0\n",
        }
        for name, text in stubs.items():
            (self.bin / name).write_text(text)
            (self.bin / name).chmod(0o755)
        self.host = gateway.dataclasses.replace(
            FakeHost("/nonexistent/keys.db").user,
            config=gateway.dataclasses.replace(
                CONFIG, credstore=str(self.credstore), socket=str(socket_path)
            ),
            spawn=gateway.production_host().spawn,
        )

    def run_credentials(self, **env):
        path = {"PATH": f"{self.bin}:{os.environ['PATH']}", **env}
        with mock.patch.dict(os.environ, path):
            return gateway.main(["credentials", "alpha"], host=self.host)

    def test_the_key_reaches_the_credential_through_the_pipe_only(self):
        self.assertEqual(self.run_credentials(), 0, self.host.err.getvalue())
        self.assertEqual(self.stored.read_text(), PROVIDER_SECRET)
        self.assertEqual(
            sorted(p.name for p in self.credstore.iterdir()), [self.stored.name]
        )
        argv_log = (self.tmp / "argv").read_text()
        self.assertNotIn(PROVIDER_SECRET, argv_log)
        self.assertIn("systemctl restart llm-gateway", argv_log)

    def test_a_failed_op_read_leaves_the_stored_credential_byte_identical(self):
        self.stored.write_bytes(b"\x00previous credential\xff")
        self.assertEqual(self.run_credentials(OP_FAIL="1"), 1)
        self.assertEqual(self.stored.read_bytes(), b"\x00previous credential\xff")
        self.assertEqual(
            sorted(p.name for p in self.credstore.iterdir()), [self.stored.name]
        )
        self.assertNotIn("systemctl", (self.tmp / "argv").read_text())


class Production(unittest.TestCase):
    def test_privileged_reexecs_this_script_under_sudo_as_the_service_user(self):
        with mock.patch.object(gateway.subprocess, "run") as run:
            run.return_value = subprocess.CompletedProcess([], 0, "out")
            self.assertEqual(gateway.production_host().privileged(["list"]), (0, "out"))
        argv = run.call_args.args[0]
        self.assertEqual(argv[:4], ["sudo", "-u", "llm-gateway", "--"])
        self.assertTrue(Path(argv[4]).is_absolute())
        self.assertEqual(Path(argv[4]).name, "llm-gateway")
        self.assertEqual(argv[5:], ["list"])

    def test_baked_config_names_configured_models_and_providers(self):
        config = gateway.production_host().config
        self.assertTrue(config.models)
        self.assertTrue(
            all(ref.startswith("op://") for ref in config.providers.values())
        )
        self.assertTrue(Path(config.db).is_absolute())


