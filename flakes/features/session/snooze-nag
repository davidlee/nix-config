#!/usr/bin/env bash
# Bedtime prompt. A successful warning and an unanswered prompt are required
# for automatic suspend; notification or audio failures leave the host awake.
set -euo pipefail
export PATH="$PATH:/etc/profiles/per-user/$USER/bin:/run/current-system/sw/bin:$HOME/.nix-profile/bin"

unit=${SNOOZE_UNIT:-60}
night=${SNOOZE_NIGHT:-22}
morning=${SNOOZE_MORNING:-5}
speakers=${SNOOZE_SPEAKERS:-alsa_output.usb-ZhuHai-JieLi-Technology_USB_AUDIO_20180105-01.analog-stereo}

bedtime() {
  local hour
  hour=$(date +%-H)
  [ "$hour" -ge "$night" ] || [ "$hour" -lt "$morning" ]
}

while bedtime; do
  tmp=$(mktemp -d)
  notify-send --urgency=critical --expire-time=0 --wait \
    --action=bed='Bed now' --action=5='Snooze 5m' \
    --action=20='Snooze 20m' --action=40='Snooze 40m' \
    --action=60='Snooze 60m' 'Go to bed' \
    'The machine will suspend two minutes after the spoken warning.' >"$tmp/answer" &
  prompt=$!
  # Give an immediately failing notification a chance to report failure.
  sleep 1
  warned=false
  if kill -0 "$prompt" 2>/dev/null && \
    pactl list short sinks | awk -v sink="$speakers" '$2 == sink {found=1} END {exit !found}' && \
    [ "$(pactl get-sink-mute "$speakers")" = 'Mute: no' ] && \
    say -d "$speakers" 'Bedtime. This computer will suspend in two minutes.'; then
    warned=true
  fi
  rc=0
  if kill -0 "$prompt" 2>/dev/null; then
    sleep "$((2 * unit))" &
    timer=$!
    wait -n "$prompt" "$timer" || rc=$?
  else
    timer=
    wait "$prompt" || rc=$?
  fi
  if kill -0 "$prompt" 2>/dev/null; then
    kill "$prompt" 2>/dev/null || true
    wait "$prompt" 2>/dev/null || true
    if [ "$warned" = true ]; then systemctl suspend; fi
    delay=5
  else
    answer=$(cat "$tmp/answer")
    delay=5
    if [ "$rc" -eq 0 ]; then
      case "$answer" in
        bed) systemctl suspend ;;
        5|20|40|60) delay=$answer ;;
      esac
    fi
  fi
  if [ -n "$timer" ]; then
    kill "$timer" 2>/dev/null || true
    wait "$timer" 2>/dev/null || true
  fi
  rm -rf "$tmp"
  sleep "$((delay * unit))"
done
