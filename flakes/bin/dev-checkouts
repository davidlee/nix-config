#!/usr/bin/env bash
# The flake inputs developed in a local checkout (DEC-037), and the one place
# that list is written. Every input is declared by its remote URL; a checkout
# on this machine overrides it for read-only recipes only (DEC-038).
#
#   dev-checkouts override   --override-input <i> git+file://<root>/<i>, per present checkout;
#                            warns (stderr) per checkout with untracked files the build won't see
#   dev-checkouts stub       --override-input <i> path:<repo>/features/stub, per listed input
#   dev-checkouts ahead      warn (stderr) per present checkout ahead of its upstream
#   dev-checkouts names      the listed inputs
#   dev-checkouts path <n>…  where each named repo is checked out on this host, one
#                            per line, present or not (room-bump, room-behind)
#   dev-checkouts repos      every local repo a lock draws on, for upgrade to push:
#                            present inputs and the fleet's inputs with a checkout,
#                            less any whose origin is not $owner's
#
# Where a repo is checked out, first match:
#   fleet                  $FLAKES_FLEET, default /srv/fleet: this host's
#                          declaration rather than a project (oubliette SL-004)
#   a capsule profile      its .path: the fleet's targets declare each room repo's
#                          checkout, rendered into $CAPSULE_PROFILE_DIR, default
#                          /var/lib/capsule-profiles (~/notes, ~/.config/emacs, …)
#   otherwise              $FLAKES_DEV/<name>, default ~/dev/<name>
# <checkout>/.git marks one present. Simulating a machine without checkouts
# takes both FLAKES_DEV and CAPSULE_PROFILE_DIR aimed at nothing.
# git+file, not path:, so only tracked files reach the store, as a GitHub
# fetch of the same revision gives a machine without the checkout.
set -euo pipefail

inputs=(emskin fleet goad malebolge panopticon quotient satan satan-attrd screwtape)
root=${FLAKES_DEV:-$HOME/dev}
fleet=${FLAKES_FLEET:-/srv/fleet}
profiles=${CAPSULE_PROFILE_DIR:-/var/lib/capsule-profiles}
owner=davidlee
repo=$(cd "$(dirname "$0")/.." && pwd)

# warn <message> — "dev-checkouts: <message>" on stderr; red on a terminal
# unless NO_COLOR is set, and blank-line separated there, to stand apart from
# each other and from the flags on stdout.
warn() {
  if [[ -t 2 && -z ${NO_COLOR:-} ]]; then
    printf '\e[31mdev-checkouts: %s\e[0m\n\n' "$1" >&2
  else
    printf 'dev-checkouts: %s\n' "$1" >&2
  fi
}

usage() { echo "usage: dev-checkouts override|stub|ahead|names|path <name>…|repos" >&2; }

# The flags travel as one space-separated string (justfile, gate-probe), so a
# root with whitespace would split into wrong flags.
if [[ $root =~ [[:space:]] ]]; then
  warn "checkout root '$root' contains whitespace; set FLAKES_DEV"
  exit 1
fi
if [[ $fleet =~ [[:space:]] ]]; then
  warn "fleet checkout '$fleet' contains whitespace; set FLAKES_FLEET"
  exit 1
fi

checkout() {
  local path=
  if [[ $1 == fleet ]]; then
    path=$fleet
  elif [[ -e $profiles/$1.json ]]; then
    path=$(jq -r '.path // empty' "$profiles/$1.json")
  fi
  echo "${path:-$root/$1}"
}
present() { [[ -e $(checkout "$1")/.git ]]; }

# foreign <dir> — its origin is someone else's repository, so a push would fail.
# No origin is not foreign: upgrade's push says so itself.
foreign() {
  local url
  url=$(git -C "$1" remote get-url --push origin 2>/dev/null) || return 1
  [[ $url != *[:/]$owner/* ]]
}

# git+file builds a dirty tree's tracked edits but not its untracked files, so
# an edit that imports a not-yet-added file builds broken.
warn_untracked() {
  local files
  mapfile -t files < <(git -C "$(checkout "$1")" ls-files --others --exclude-standard)
  ((${#files[@]})) || return 0
  warn "$1 has ${#files[@]} untracked file(s) its build won't see (git add or ignore them): ${files[*]:0:3}$( ((${#files[@]} > 3)) && echo ' …')"
}

flags=()
case ${1:-} in
override)
  for i in "${inputs[@]}"; do
    present "$i" || continue
    flags+=(--override-input "$i" "git+file://$(checkout "$i")")
    warn_untracked "$i"
  done
  ;;
stub)
  for i in "${inputs[@]}"; do flags+=(--override-input "$i" "path:$repo/features/stub"); done
  ;;
ahead)
  for i in "${inputs[@]}"; do
    present "$i" || continue
    if ! n=$(git -C "$(checkout "$i")" rev-list --count '@{upstream}..HEAD' 2>/dev/null); then
      warn "$i has no upstream; update-local locks its remote"
    elif ((n > 0)); then
      warn "$i is $n commit(s) ahead of its upstream; update-local locks the remote"
    fi
  done
  ;;
names)
  flags=("${inputs[@]}")
  ;;
path)
  shift
  for i in "$@"; do flags+=("$(checkout "$i")"); done
  ((${#flags[@]} == 0)) || printf '%s\n' "${flags[@]}"
  exit 0
  ;;
repos)
  names=("${inputs[@]}")
  [[ ! -e $fleet/flake.lock ]] || mapfile -t -O "${#names[@]}" names < <(jq -r '.nodes.root.inputs | keys[]' "$fleet/flake.lock")
  mapfile -t flags < <(
    for i in "${names[@]}"; do
      present "$i" || continue
      dir=$(checkout "$i")
      foreign "$dir" || echo "$dir"
    done | LC_ALL=C sort -u
  )
  ;;
*)
  usage
  exit 1
  ;;
esac

if ((${#flags[@]})); then echo "${flags[*]}"; fi
