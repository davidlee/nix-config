#!/usr/bin/env bash
# Behaviour tests for dev-checkouts. Each case builds a throwaway checkout root
# (FLAKES_DEV) holding some of the listed inputs, then asserts what each verb
# prints. The fleet (FLAKES_FLEET) and the capsule profiles (CAPSULE_PROFILE_DIR)
# name checkouts outside that root, so every case aims both into the throwaway
# tree too: this host's /srv/fleet and profiles must not reach a case. No
# network: "ahead" and "repos" clone local bare repositories.
#
#   ./dev-checkouts-test

set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
script=$here/dev-checkouts
repo=$(cd "$here/.." && pwd)
stub=path:$repo/features/stub

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
export FLAKES_FLEET=$work/fleet
export CAPSULE_PROFILE_DIR=$work/profiles
mkdir -p "$CAPSULE_PROFILE_DIR"

export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t

# ---------------------------------------------------------------- harness

failed=0

check() { # <what> <expected> <actual>
  if [ "$2" = "$3" ]; then
    printf 'ok   %s\n' "$1"
  else
    printf 'FAIL %s\n       expected: %s\n       actual:   %s\n' "$1" "$2" "$3"
    failed=1
  fi
}

# root <name> <input>… — a fresh checkout root holding a git repo per input
root() {
  local dir=$work/$1
  shift
  mkdir -p "$dir"
  for input in "$@"; do git init -q "$dir/$input"; done
  printf '%s' "$dir"
}

# dc <root> <verb> [arg…] — run the script; leaves $out, $err and $rc
dc() {
  local dir=$1
  shift
  rc=0
  out=$(FLAKES_DEV=$dir "$script" "$@" 2>"$work/err") || rc=$?
  err=$(<"$work/err")
}

# profile <name> <path> — a capsule profile placing <name>'s checkout at <path>
profile() { printf '{"name": "%s", "path": "%s"}\n' "$1" "$2" >"$CAPSULE_PROFILE_DIR/$1.json"; }

# ------------------------------------------------------------------ cases

none=$(root none)
dc "$none" override
check 'override: nothing present, nothing printed' '' "$out"
check 'override: nothing present is not an error' 0 "$rc"

some=$(root some panopticon goad)
dc "$some" override
check 'override: present checkouts, in list order, as git+file' \
  "--override-input goad git+file://$some/goad --override-input panopticon git+file://$some/panopticon" "$out"

# a directory without .git is not a checkout
mkdir -p "$some/satan-attrd"
dc "$some" override
check 'override: a directory without .git is not present' \
  "--override-input goad git+file://$some/goad --override-input panopticon git+file://$some/panopticon" "$out"

dc "$none" stub
check 'stub: every listed input, present or not' \
  "--override-input emskin $stub --override-input fleet $stub --override-input goad $stub --override-input malebolge $stub --override-input panopticon $stub --override-input quotient $stub --override-input satan $stub --override-input satan-attrd $stub --override-input screwtape $stub" "$out"

dc "$none" names
check 'names: the list, space-separated' 'emskin fleet goad malebolge panopticon quotient satan satan-attrd screwtape' "$out"

check 'override: clean checkouts warn nothing' '' "$err"

# override: a present checkout's untracked files miss the git+file build (only
# tracked files reach the store), so each such checkout is named on stderr
dirty=$(root dirty goad panopticon)
mkdir -p "$dirty/goad/src"
touch "$dirty/goad/src/new.ts" "$dirty/goad/src/other.ts"
printf 'ignored.ts\n' >"$dirty/panopticon/.gitignore"
git -C "$dirty/panopticon" add .gitignore
touch "$dirty/panopticon/ignored.ts"
dc "$dirty" override
check 'untracked: warns once, for the checkout with untracked files' 1 "$(grep -c . <<<"$err")"
check 'untracked: names the checkout and its files' 1 "$(grep -c 'goad has 2 untracked .*src/new.ts' <<<"$err")"
check 'untracked: stdout keeps the flags' \
  "--override-input goad git+file://$dirty/goad --override-input panopticon git+file://$dirty/panopticon" "$out"
check 'untracked: is not an error' 0 "$rc"

# the fleet's checkout is FLAKES_FLEET, not <root>/fleet, and keeps list order
git init -q "$FLAKES_FLEET"
dc "$some" override
check 'override: the fleet from its own path, first' \
  "--override-input fleet git+file://$FLAKES_FLEET --override-input goad git+file://$some/goad --override-input panopticon git+file://$some/panopticon" "$out"
git init -q "$none/fleet"
dc "$none" override
check 'override: <root>/fleet is not the fleet' "--override-input fleet git+file://$FLAKES_FLEET" "$out"
rm -rf "$FLAKES_FLEET" "$none/fleet"

# The overrides travel as one space-separated string, so a root with a space
# would split into wrong flags. Refused, naming the root.
spaced=$(root 'has space' goad)
dc "$spaced" override
check 'whitespace root: refused' 1 "$rc"
check 'whitespace root: names it' 1 "$(grep -c "$spaced" <<<"$err" || true)"
check 'whitespace root: prints no flags' '' "$out"
out=$(FLAKES_DEV=$none FLAKES_FLEET="$work/has space/fleet" "$script" override 2>"$work/err") && rc=0 || rc=$?
check 'whitespace fleet: refused' 1 "$rc"
check 'whitespace fleet: names it' 1 "$(grep -c "has space/fleet" "$work/err" || true)"

# ahead: one warning per present checkout ahead of its upstream, on stderr
ahead=$(root ahead)
git init -q --bare "$work/upstream.git"
for input in goad satan-attrd; do
  git clone -q "$work/upstream.git" "$ahead/$input" 2>/dev/null
  git -C "$ahead/$input" commit -q --allow-empty -m base
  git -C "$ahead/$input" push -q origin HEAD 2>/dev/null
done
git -C "$ahead/goad" commit -q --allow-empty -m unpushed
dc "$ahead" ahead
check 'ahead: warns only for the checkout ahead of its upstream' 1 "$(grep -c . <<<"$err")"
check 'ahead: names it' 1 "$(grep -c 'goad' <<<"$err")"
check 'ahead: prints nothing on stdout' '' "$out"
check 'ahead: is not an error' 0 "$rc"

# ahead: a present checkout with no upstream is named, not an error
lone=$(root lone satan-attrd)
dc "$lone" ahead
check 'ahead: no upstream is named' 1 "$(grep -c 'satan-attrd has no upstream' <<<"$err")"
check 'ahead: no upstream is not an error' 0 "$rc"

# a git worktree (its .git is a file) is a checkout
tree=$(root tree)
git -C "$ahead/goad" worktree add -q "$tree/panopticon" 2>/dev/null
dc "$tree" override
check 'override: a worktree checkout is present' "--override-input panopticon git+file://$tree/panopticon" "$out"

dc "$none" bogus
check 'unknown verb: refused' 1 "$rc"
check 'unknown verb: prints usage' 1 "$(grep -c '^usage:' <<<"$err")"

# FLAKES_DEV unset: the root is ~/dev
mkdir -p "$work/home/dev"
git init -q "$work/home/dev/goad"
out=$(env -u FLAKES_DEV HOME="$work/home" "$script" override)
check 'default root: ~/dev' "--override-input goad git+file://$work/home/dev/goad" "$out"

# path: where each name is checked out — the fleet at FLAKES_FLEET, else the
# path its capsule profile names, else <root>/<name>; one line per name, present
# or not
profile notes "$work/elsewhere/notes"
dc "$none" path goad notes fleet
check 'path: root, then profile, then the fleet' \
  "$none/goad"$'\n'"$work/elsewhere/notes"$'\n'"$FLAKES_FLEET" "$out"
check 'path: is not an error' 0 "$rc"
rm "$CAPSULE_PROFILE_DIR/notes.json"

# override: a listed input whose profile places it outside the root
git init -q "$work/elsewhere/goad"
profile goad "$work/elsewhere/goad"
dc "$some" override
check 'override: a profiled input from its profile path' \
  "--override-input goad git+file://$work/elsewhere/goad --override-input panopticon git+file://$some/panopticon" "$out"
rm "$CAPSULE_PROFILE_DIR/goad.json"

# repos: every input present and every fleet input with a checkout, wherever
# its profile places it, once each; less a checkout that pushes to someone
# else's repository, which upgrade could not push
repos=$(root repos goad oubliette unrelated)
for r in notes pi; do mkdir -p "$work/elsewhere/$r" && git init -q "$work/elsewhere/$r" && profile "$r" "$work/elsewhere/$r"; done
git -C "$work/elsewhere/notes" remote add origin git@github.com:davidlee/notes.git
git -C "$work/elsewhere/pi" remote add origin git@github.com:someone/pi.git
mkdir -p "$work/fleet"
git init -q "$work/fleet"
echo '{"nodes":{"root":{"inputs":{"goad":"goad_2","notes":"notes","oubliette":"oubliette","pi":"pi","absent":"absent"}}}}' >"$work/fleet/flake.lock"
dc "$repos" repos
check 'repos: inputs and fleet inputs by profile, once each; no unlisted or foreign checkout' \
  "$work/elsewhere/notes $work/fleet $repos/goad $repos/oubliette" "$out"
rm -rf "$work/fleet"

exit "$failed"
