#!/usr/bin/env bash
# Behaviour tests for upgrade. Each case builds a throwaway stack: a home repo
# holding the root flake and its sub-flakes, a fleet and a dev checkout, each
# with a bare upstream, and runs a copy of bin/ from inside it. Fake `nix` and
# `just` on PATH append to one log; each nix line carries how many commits the
# home upstream holds at that moment, which is what proves the order. No network.
#
#   ./upgrade-test

set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t

mkdir -p "$work/bin"
cat >"$work/bin/nix" <<'EOF'
#!/usr/bin/env bash
[[ "$1 $2" == "flake update" ]] || { echo "fake nix: unexpected $*" >&2; exit 9; }
shift 2
echo "nix $(basename "$PWD") $(git --git-dir="$HOME_UPSTREAM" rev-list --count HEAD): $*" >>"$LOG"
[[ -n ${FAKE_NIX_NOOP:-} ]] || echo "$*" >>flake.lock
EOF
cat >"$work/bin/just" <<'EOF'
#!/usr/bin/env bash
echo "just $*" >>"$LOG"
[[ " $* " != *" ${FAKE_JUST_FAIL:-none} "* ]]
EOF
chmod +x "$work/bin/nix" "$work/bin/just"
export PATH=$work/bin:$PATH

# ---------------------------------------------------------------- harness

failed=0

check() { # <what> <expected> <actual>
  if [ "$2" = "$3" ]; then
    printf 'ok   %s\n' "$1"
  else
    printf 'FAIL %s\n       expected: %s\n       actual:   %s\n' "$1" "$2" "$3"
    failed=1
  fi
}

lock='{"nodes":{"root":{"inputs":{"goad":"goad_2","nixpkgs":"nixpkgs_3","stable":"stable","zmux":["agents","zmux"]}}}}'

# published <dir> — <dir> as a clone of a new bare <dir>.git, its tree committed and pushed
published() {
  git init -q --bare "$1.git"
  git -C "$1" init -q
  git -C "$1" remote add origin "$1.git"
  git -C "$1" add .
  git -C "$1" commit -q -m init
  git -C "$1" push -q -u origin HEAD
}

# case_ <name> — a fresh stack; sets $home, $flakes, $fleet, $goad and $LOG
case_() {
  local dir=$work/$1 sub
  home=$dir/home flakes=$dir/home/flakes fleet=$dir/fleet goad=$dir/dev/goad
  for sub in "$flakes" "$flakes/agents" "$flakes/emacs" "$flakes/dev-envs" "$fleet"; do
    mkdir -p "$sub"
    echo "$lock" >"$sub/flake.lock"
    echo '{}' >"$sub/flake.nix"
  done
  mkdir -p "$flakes/bin" "$goad"
  cp "$here"/{upgrade,room-bump,dev-checkouts} "$flakes/bin/"
  echo goad >"$goad/file"
  published "$home"
  published "$fleet"
  published "$goad"
  git -C "$goad" commit -q --allow-empty -m unpushed
  LOG=$dir/log HOME_UPSTREAM=$home.git
  : >"$LOG"
  export LOG HOME_UPSTREAM
}

# up [args] — run the copy; leaves $out and $rc
up() {
  rc=0
  out=$(HOME=$home FLAKES_FLEET=$fleet FLAKES_DEV=$(dirname "$goad") "$flakes/bin/upgrade" "$@" 2>&1) || rc=$?
}

upstream() { git --git-dir="$1.git" rev-list --count HEAD; }

# ------------------------------------------------------------------ cases

case_ full
up
check 'full: succeeds' 0 "$rc"
check 'full: each lock moves after what it locks is published, then verify, then switch' \
  'nix agents 1: goad nixpkgs stable
nix emacs 2: goad nixpkgs stable
nix dev-envs 3: goad nixpkgs stable
nix fleet 4: goad nixpkgs stable
nix flakes 4: goad nixpkgs stable
just system-build home-build test
just system-switch home-switch' "$(<"$LOG")"
check 'full: checkouts are pushed' 2 "$(upstream "$goad")"
check 'full: every home lock is pushed' 5 "$(upstream "$home")"
check 'full: the fleet lock is pushed' 2 "$(upstream "$fleet")"
check 'full: a home commit holds only its lock' 'flakes/agents/flake.lock' \
  "$(git -C "$home" log --format= --name-only --skip=3 -1)"
check 'full: reminds about the room' 1 "$(grep -c 'just update-room' <<<"$out" || true)"

case_ keep
up --keep-nixpkgs
check 'keep: succeeds' 0 "$rc"
check 'keep: no lock moves nixpkgs or stable' 5 "$(grep -c ': goad$' "$LOG")"

case_ dirty-root
echo edit >>"$flakes/flake.lock"
up
check 'dirty root lock: refused' 1 "$rc"
check 'dirty root lock: names it' 1 "$(grep -c "$flakes has uncommitted" <<<"$out" || true)"
check 'dirty root lock: nothing runs' '' "$(<"$LOG")"
check 'dirty root lock: nothing is pushed' 1 "$(upstream "$goad")"

case_ dirty-sub
echo edit >>"$flakes/agents/flake.nix"
up
check 'dirty sub-flake: refused' 1 "$rc"

case_ dirty-fleet
echo edit >>"$fleet/flake.lock"
up
check 'dirty fleet lock: refused' 1 "$rc"
check 'dirty fleet lock: nothing is pushed' 1 "$(upstream "$goad")"

case_ broken
FAKE_JUST_FAIL='test' up
check 'failed verify: fails' 1 "$rc"
check 'failed verify: no switch' 0 "$(grep -c switch "$LOG" || true)"
check 'failed verify: the root lock is not published' 4 "$(upstream "$home")"
check 'failed verify: the root lock stays for inspection' 1 "$(git -C "$flakes" diff --name-only -- flake.lock | wc -l)"

case_ current
FAKE_NIX_NOOP=1 up
check 'nothing moved: succeeds' 0 "$rc"
check 'nothing moved: no home commit' 1 "$(upstream "$home")"
check 'nothing moved: still switches' 1 "$(grep -c switch "$LOG")"

case_ usage
up --bogus
check 'unknown flag: refused' 2 "$rc"
check 'unknown flag: prints usage' 1 "$(grep -c '^usage:' <<<"$out" || true)"
check 'unknown flag: nothing runs' '' "$(<"$LOG")"

exit "$failed"
