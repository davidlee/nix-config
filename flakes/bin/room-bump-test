#!/usr/bin/env bash
# Behaviour tests for room-bump. Each case builds a throwaway fleet repo
# (FLAKES_FLEET) and checkout root (FLAKES_DEV); a fake `nix` on PATH stands in
# for `nix flake update`, appending each input it is given to flake.lock (or
# nothing, with FAKE_NIX_NOOP). No network: upstreams are local bare repos.
#
#   ./room-bump-test

set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
script=$here/room-bump

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t

mkdir -p "$work/bin"
cat >"$work/bin/nix" <<'EOF'
#!/usr/bin/env bash
[[ "$1 $2" == "flake update" ]] || { echo "fake nix: unexpected $*" >&2; exit 9; }
shift 2
[[ -n ${FAKE_NIX_NOOP:-} ]] || printf '%s\n' "$@" >>flake.lock
EOF
chmod +x "$work/bin/nix"
export PATH=$work/bin:$PATH

# ---------------------------------------------------------------- harness

failed=0

check() { # <what> <expected> <actual>
  if [ "$2" = "$3" ]; then
    printf 'ok   %s\n' "$1"
  else
    printf 'FAIL %s\n       expected: %s\n       actual:   %s\n' "$1" "$2" "$3"
    failed=1
  fi
}

# case <name> — a fresh fleet (one commit holding flake.lock) and an empty
# checkout root; sets $fleet and $dev
case_() {
  fleet=$work/$1/fleet dev=$work/$1/dev
  mkdir -p "$dev"
  git init -q "$fleet"
  echo lock >"$fleet/flake.lock"
  git -C "$fleet" add flake.lock
  git -C "$fleet" commit -q -m init
}

# pushed <input> — a checkout of <input> level with its upstream
pushed() {
  git init -q --bare "$work/$1-$2.git"
  git clone -q "$work/$1-$2.git" "$dev/$2" 2>/dev/null
  git -C "$dev/$2" commit -q --allow-empty -m base
  git -C "$dev/$2" push -q origin HEAD 2>/dev/null
}

# rb <input>… — run the script; leaves $err and $rc (it prints only to stderr)
rb() {
  rc=0
  FLAKES_FLEET=$fleet FLAKES_DEV=$dev "$script" "$@" >/dev/null 2>"$work/err" || rc=$?
  err=$(<"$work/err")
}

commits() { git -C "$fleet" rev-list --count HEAD; }

# ------------------------------------------------------------------ cases

case_ ok
pushed ok goad
pushed ok malebolge
echo scratch >"$fleet/notes.txt" && git -C "$fleet" add notes.txt && git -C "$fleet" commit -q -m notes
echo edited >>"$fleet/notes.txt"
rb goad malebolge
check 'pushed: succeeds' 0 "$rc"
check 'pushed: locks each named input' $'lock\ngoad\nmalebolge' "$(git -C "$fleet" show HEAD:flake.lock)"
check 'pushed: commit message names the inputs' 'bump goad malebolge' "$(git -C "$fleet" log -1 --format=%s)"
check 'pushed: commits only flake.lock' 'flake.lock' "$(git -C "$fleet" show --name-only --format= HEAD)"
check 'pushed: leaves other edits uncommitted' ' M notes.txt' "$(git -C "$fleet" status --porcelain)"

case_ ahead
pushed ahead goad
pushed ahead malebolge
git -C "$dev/malebolge" commit -q --allow-empty -m unpushed
rb goad malebolge
check 'ahead: refused' 1 "$rc"
check 'ahead: names it' 1 "$(grep -c 'malebolge is 1 commit(s) ahead' <<<"$err" || true)"
check 'ahead: lock untouched' '' "$(git -C "$fleet" status --porcelain)"
check 'ahead: nothing committed' 1 "$(commits)"

case_ lone
git init -q "$dev/goad"
rb goad
check 'no upstream: refused' 1 "$rc"
check 'no upstream: names it' 1 "$(grep -c 'goad has no upstream' <<<"$err" || true)"

case_ absent
rb notes
check 'no checkout: succeeds' 0 "$rc"
check 'no checkout: says it was not checked' 1 "$(grep -c 'notes: no checkout' <<<"$err" || true)"
check 'no checkout: still bumped' 'bump notes' "$(git -C "$fleet" log -1 --format=%s)"

case_ current
pushed current goad
FAKE_NIX_NOOP=1 rb goad
check 'already current: succeeds' 0 "$rc"
check 'already current: nothing committed' 1 "$(commits)"
check 'already current: says so' 1 "$(grep -c 'already current' <<<"$err" || true)"

case_ dirty
pushed dirty goad
echo hand-edit >>"$fleet/flake.lock"
rb goad
check 'dirty lock: refused' 1 "$rc"
check 'dirty lock: names it' 1 "$(grep -c 'flake.lock has uncommitted changes' <<<"$err" || true)"
check 'dirty lock: nothing committed' 1 "$(commits)"

case_ usage
rb
check 'no inputs: refused' 1 "$rc"
check 'no inputs: prints usage' 1 "$(grep -c '^usage:' <<<"$err" || true)"

exit "$failed"
