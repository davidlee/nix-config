// https://niri-wm.github.io/niri/Configuration:-Window-Rules

// ================================================================
// WINDOW RULES
// ================================================================

window-rule {
    draw-border-with-background false
    geometry-corner-radius 12
    clip-to-geometry true
    background-effect {
        blur true
        xray true
    }

}
window-rule {
    match app-id=r#"^com.mitchellh.ghostty$"#;
    opacity 0.85
}
// highlight screencast
window-rule {
    match is-window-cast-target=true
    border {
        inactive-color "#ff0000"
    }
    tab-indicator {
        active-color "#f38ba8"
        inactive-color "7d0d2d"
    }
}
window-rule {
    match is-urgent=true
    match is-active=false
    border {
        inactive-color "#ff0000"
    }
}

window-rule {
    match app-id=r#"^gnome-control-center$"#
    match app-id=r#"^pavucontrol$"#
    match app-id=r#"^nm-connection-editor$"#
    default-column-width { proportion 0.5; }
    open-floating false
}

window-rule {
    match app-id=r#"^org\.gnome\.Calculator$"#
    match app-id=r#"^gnome-calculator$"#
    match app-id=r#"^galculator$"#
    match app-id=r#"^blueman-manager$"#
    match app-id=r#"^org\.gnome\.Nautilus$"#
    match app-id=r#"^xdg-desktop-portal$"#
    open-floating true
}
window-rule {
    match app-id=r#"^steam$"# title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
    open-focused true
}

// https://github.com/Drakulix/cosmic-ext-extra-sessions/tree/main/niri

window-rule {
    match app-id="slack"
    open-floating true
}

window-rule {
    match app-id="signal"
    open-floating true
}

// App ID is "Zoom" (capitalised) — a lowercase match never fires.
window-rule {
    match app-id=r#"^Zoom$"#
    open-floating true
    open-focused true
}
window-rule {
    match app-id="Spotify"
    open-floating true
}

// ================================================================
// LAYERS


// ================================================================
// Block out notifications from screencasts.
layer-rule {
    match namespace="^notifications$"
    block-out-from "screencast"
}

// Enable blur behind the fuzzel launcher.
layer-rule {
    match namespace="^launcher$"
    background-effect {
        blur true
    }
}

layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop true
}

layer-rule {
    match namespace=r#"^wallpaper$"#
    place-within-backdrop true
}
