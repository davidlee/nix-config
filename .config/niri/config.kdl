// ================================================================
// https://github.com/YaLTeR/niri/wiki/Configuration:-Introduction

workspace "project"
workspace "emacs"
workspace "browser"
workspace "dev"
workspace "work"
workspace "util"
workspace "comms"
workspace "media"

spawn-at-startup "noctalia"
spawn-at-startup "stasis"
spawn-at-startup "stasis tray"
spawn-at-startup "niriusd"
spawn-at-startup "vicinae" "server"

include "layout.kdl"
include "binds.kdl"
include "rules.kdl"
include "io.kdl"
include "apps.kdl"
include "animation.kdl"

// ================================================================

// config-notification { disable-failed; }

screenshot-path "~/Pictures/Screenshots/shot_%Y-%m-%d_%H-%M-%S.png"
hotkey-overlay { skip-at-startup; }
gestures {
    hot-corners { off; }
}
cursor {
    xcursor-theme "breeze_cursors"
    xcursor-size 48
    hide-when-typing
    hide-after-inactive-ms 800
}
environment {
    XDG_CURRENT_DESKTOP "niri"
}
blur {
    passes 3
    offset 3.0
    noise 0.02
    saturation 1.2
}
debug {
    honor-xdg-activation-with-invalid-serial
    // Dual-GPU (dGPU Navi 48 drives the display, iGPU is card0/default render
    // node). Per-window screencast offered dGPU explicit dmabuf modifiers the
    // consumer couldn't import → "no more input formats" (res=-32) → black share,
    // while full-output worked. Force the implicit/invalid modifier so any
    // consumer imports the buffer. See zoom-sucks.md.
    force-pipewire-invalid-modifier
}


include "noctalia.kdl"
