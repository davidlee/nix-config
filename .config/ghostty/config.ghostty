################################################################################
#
# Behaviour
#
################################################################################

gtk-single-instance = detect
gtk-quick-terminal-layer = overlay
macos-option-as-alt = true

clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard
right-click-action = copy-or-paste

confirm-close-surface = false
app-notifications = no-clipboard-copy,no-config-reload
notify-on-command-finish = unfocused
link-previews = true
bell-features = system

shell-integration = zsh
shell-integration-features = cursor,sudo,ssh-env,ssh-terminfo

linux-cgroup = always
linux-cgroup-memory-limit = 4294967296

#
# quick terminal
#

quick-terminal-keyboard-interactivity = exclusive
quick-terminal-autohide = false
quick-terminal-animation-duration = 0.5
quick-terminal-size = 80%



################################################################################
#
# Presentation
#
################################################################################

# theme = noctalia
config-file = ?auto/theme.ghostty

cursor-style = block
cursor-style-blink = true
mouse-hide-while-typing = true

background-opacity = 1.0
background-blur = true

faint-opacity = 0.2

unfocused-split-opacity = 0.7
unfocused-split-fill = #44464f

window-decoration = false
window-padding-x = 10
window-padding-y = 10
# window-padding-balance = true
# window-padding-color = background
window-theme = dark
window-title-font-family="Inconsolata"
window-decoration = none
#
# zmux - bottom bar
#

gtk-titlebar = true
gtk-titlebar-style = native
gtk-tabs-location = bottom
gtk-wide-tabs = true
gtk-toolbar-style = raised
gtk-custom-css = ~/dev/zmux/ghostty.css
gtk-titlebar-hide-when-maximized = true
window-show-tab-bar = always
# we set the title ourselves
shell-integration-features = no-title

#
# Fonts
#

font-family="Hasklug Nerd Font"
font-size=14
font-feature=+liga

# ghostty +list-fonts | rg -i '^[^\s].*nerd' | sed -e 's/ Nerd Font.*//'| uniq

#
# Shaders
#

custom-shader-animation = always
custom-shader = ./ghostty-shaders/cursor_blaze.glsl
custom-shader = ./ghostty-shaders/in-game-crt-cursor.glsl
custom-shader = ./ghostty-cursor-shaders/cursor_tail.glsl
# custom-shader = ~/.local/src/crt-shader-with-chromatic-aberration-glow-scanlines-dot-matrix/crt-shader-with-chromatic-aberration-glow-scanlines-dot-matrix.glsl

################################################################################
#
# Keybinds
#
################################################################################

keybind = ctrl+shift+n=new_window
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
keybind = shift+enter=text:\n
keybind = global:ctrl+shift+backquote=toggle_quick_terminal
keybind = global:ctrl+shift+grave_accent=toggle_quick_terminal
keybind = ctrl+shift+bracket_left=goto_split:previous
keybind = ctrl+shift+bracket_right=goto_split:next
keybind = ctrl+shift+space=toggle_command_palette
theme = noctalia
