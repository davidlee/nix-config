#!/usr/bin/env python3
"""Move the focused window into or out of a scratchpad.

Usage: toggle-window-scratchpad <fallback-pad>

  in a pad                       -> move it out
  on a workspace, with a pad     -> move it to the pad its window rule names
  on a workspace, without a pad  -> move it to the fallback pad

window-toggle-scratchpad <pad> restores only a member of <pad>. Given any other
pad, it moves the workspace window behind the focused one instead, so this
names the pad that makes it act on the focused window.

Umbriel doesn't report a window's default_scratchpad, so this reads the rules
in apps.toml, which owns them. They may match only on app_id and title.
"""

import json
import pathlib
import re
import subprocess
import sys
import tomllib

APPS_CONFIG = pathlib.Path(__file__).resolve().parent.parent / "apps.toml"


def rule_pad(window, rules):
    """The pad the window's rules name: as in Umbriel, the last match wins and patterns search."""
    pads = [
        rule["default_scratchpad"]
        for rule in rules
        if "default_scratchpad" in rule
        and all(re.search(pattern, window[key]) for key, pattern in rule["match"].items())
    ]
    return pads[-1] if pads else None


def target_pad(window, rules, fallback):
    """The pad to name in window-toggle-scratchpad for this window."""
    return window["scratchpad"] or rule_pad(window, rules) or fallback


def main():
    if len(sys.argv) != 2:
        print("usage: toggle-window-scratchpad <fallback-pad>", file=sys.stderr)
        return 2
    windows = json.loads(subprocess.check_output(["umbriel", "windows", "--json"]))
    focused = next((window for window in windows if window["active"]), None)
    if focused is None:
        return 0
    rules = tomllib.loads(APPS_CONFIG.read_text())["window_rule"]
    subprocess.run(["umbriel", "msg", "window-toggle-scratchpad", target_pad(focused, rules, sys.argv[1])], check=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
