#!/usr/bin/env bash
# Create or remove a named workspace.
#
#   named-workspace add [name]    prompt when name is omitted, then switch to it
#   named-workspace drop [name]   default: the focused workspace
#
# Umbriel has no IPC action for this — a workspace name is a config
# declaration, not a runtime label. But includes are hot-reloaded, so writing
# an entry to workspaces.toml (listed under [include.optional], generated,
# absent until first use) creates one in about 300ms.
#
# This is not niri's set-workspace-name. A new workspace is always empty and
# appears at the front of its output's list; the workspace you are standing on
# cannot be named. Names declared in config.toml are left alone.
set -euo pipefail

file="${XDG_CONFIG_HOME:-$HOME/.config}/umbriel/workspaces.toml"
header='# Generated by scripts/named-workspace. Hand edits are fine: one
# [[workspace]] entry per name. Included from config.toml as an optional file,
# so deleting it just removes every workspace declared here.'

die() { echo "${0##*/}: $1" >&2; exit 1; }

names() { umbriel workspaces --json | jq -r '.[] | select(.named) | .name'; }

focused() { umbriel workspaces --json | jq -r '.[] | select(.focused and .named) | .name'; }

# Wait for the config watcher to apply the edit.
await() { # await <name> present|absent
  local i
  for ((i = 0; i < 30; i++)); do
    if names | grep -qxF "$1"; then
      [[ $2 == present ]] && return 0
    else
      [[ $2 == absent ]] && return 0
    fi
    sleep 0.1
  done
  die "timed out waiting for '$1' to be $2"
}

add() {
  local name="${1:-$(zenity --entry --title=workspace --text='new workspace name' 2>/dev/null || true)}"
  [[ -n $name ]] || exit 0
  [[ $name != *['"'$'\n']* ]] || die "a name cannot contain a quote or newline"
  [[ $name =~ ^[0-9]+$ ]] && die "an all-digit name collides with workspace positions"
  names | grep -qxF "$name" && die "'$name' already exists"

  [[ -f $file ]] || printf '%s\n' "$header" >"$file"
  printf '\n[[workspace]]\nname = "%s"\n' "$name" >>"$file"
  await "$name" present
  umbriel msg "workspace-switch:$name"
}

drop() {
  local name="${1:-$(focused)}"
  [[ -n $name ]] || die "the focused workspace has no name"
  [[ -f $file ]] || die "'$name' is not declared in ${file##*/}"

  local rest
  rest="$(awk -v want="name = \"$name\"" '
    $0 == "[[workspace]]" { held = $0; next }
    held != "" {
      if ($0 == want) { held = ""; dropped = 1; next }
      print held; held = ""
    }
    { print }
    END { if (held != "") print held; exit !dropped }
  ' "$file")" || die "'$name' is not declared in ${file##*/} — config.toml names stay put"

  printf '%s\n' "$rest" | cat -s >"$file"  # squeeze the gap the entry left
  await "$name" absent
}

case "${1:-}" in
  add) add "${2:-}" ;;
  drop) drop "${2:-}" ;;
  *) echo "usage: ${0##*/} add|drop [name]" >&2; exit 2 ;;
esac
