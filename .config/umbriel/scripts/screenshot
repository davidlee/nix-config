#!/usr/bin/env bash
# Screenshots on grim, slurp and satty; Umbriel has none built in.
#
#   screenshot area | screen | window
#
# Saves to ~/Pictures/Screenshots and copies to the clipboard.
set -euo pipefail

dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
mkdir -p "$dir"
out="$dir/shot_$(date +%Y-%m-%d_%H-%M-%S).png"

case "${1:-area}" in
  area) region=$(slurp -d) ;;
  screen) region="" ;;
  window)
    region=$(umbriel focused-window --json | jq -r '"\(.x),\(.y) \(.w)x\(.h)"')
    ;;
  *)
    echo "usage: ${0##*/} area|screen|window" >&2
    exit 2
    ;;
esac

grim ${region:+-g "$region"} - |
  satty --filename - --output-filename "$out" \
    --copy-command wl-copy --early-exit
