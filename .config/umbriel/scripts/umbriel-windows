#!/usr/bin/env bash
# Normalise `umbriel windows --json` to one line per window:
#
#   <id>\t<app_id>\t<focused>\t<x>\t<y>\t<w>\t<h>
#
# Verified against umbriel 0.1.0, which returns a bare array. Window ids are
# 32-hex strings, not integers. If a release changes the schema, this is the
# only file the other scripts need fixed.
set -euo pipefail

umbriel windows --json |
  jq -r '.[] | [.id, .app_id, (.focused | tostring), .x, .y, .w, .h] | @tsv'
